# Weekly maintenance cron image (Railway) — heavier than Dockerfile.monitors.
# Serves the jobs migrated off GitHub Actions:
#   MONITOR_NAME=security         -> scripts/security_scan.py   (Semgrep SAST)
#   MONITOR_NAME=mutation-health  -> scripts/mutation_health.py (mutmut kill rate)
# stats-refresh is run locally/on-demand (needs a git push), not scheduled here.
#
# Kept separate from Dockerfile.monitors so the lightweight monitor services
# don't have to pull semgrep + the mutmut/pytest stack.
#
# Python must match CI (.github/workflows/gates.yml): this image installs
# requirements-test.txt, which CI validates on 3.12. On 3.11 the numpy>=2.5.3
# pin (Requires-Python >=3.12) made every deploy fail from 2026-09-14, and the
# cron jobs silently kept running the last image built before that.
# tests/test_dockerfile_python_matches_ci.py enforces this.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-maintenance.txt ./scripts/requirements-maintenance.txt
COPY requirements-test.txt ./requirements-test.txt
RUN pip install --no-cache-dir \
    -r scripts/requirements-maintenance.txt \
    -r requirements-test.txt

# Source under scan / mutation. node_modules and .next are excluded via
# .dockerignore so the Semgrep scan stays fast.
COPY services/ ./services/
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY frontend-nextjs/ ./frontend-nextjs/
COPY pytest.ini ./pytest.ini

ENV PYTHONPATH=/app:/app/scripts

# Railway sets MONITOR_NAME per service; run_monitors.py dispatches + reports.
CMD ["python", "scripts/run_monitors.py"]
