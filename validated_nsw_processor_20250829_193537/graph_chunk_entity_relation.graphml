    <node id="heritage item">
      <data key="d0">heritage item</data>
      <data key="d1">category</data>
      <data key="d2">A heritage item refers to a building, work, relic, or tree that has historical significance and is protected under the Inner West Local Environmental Plan 2022.&lt;SEP&gt;A heritage item refers to a specific building, site, or object that has been identified as having historical or cultural significance.</data>
