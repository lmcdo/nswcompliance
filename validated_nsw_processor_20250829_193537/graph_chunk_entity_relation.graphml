    <node id="Development Application (DA)">
      <data key="d0">Development Application (DA)</data>
      <data key="d1">category</data>
      <data key="d2">A Development Application (DA) is a formal request for approval to carry out development, assessed against local planning controls and regulations.&lt;SEP&gt;A Development Application (DA) is a formal request for consent to carry out development under the Environmental Planning and Assessment Act 1979.</data>
      <data key="d3">chunk-c90d09fd86358ff34cca423643290bd6&lt;SEP&gt;chunk-163a135d41d128b828c33d3c1699bde4</data>
      <data key="d4">unknown_source</data>
