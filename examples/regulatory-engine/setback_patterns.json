{
  "setback_patterns": {
    "side": {
      "fixed_distance": [
        {
          "pattern": "(?P<distance>\\d+\\.?\\d*)\\s*m\\s+wide\\s+side\\s+setback\\s+for\\s+(?P<purpose>\\w+)",
          "confidence": 0.9,
          "extraction_rules": {
            "distance_field": "distance",
            "calculation_type": "fixed",
            "condition_field": "purpose",
            "condition_type": "use_type"
          }
        },
        {
          "pattern": "side\\s+setback.*?(?P<distance>\\d+\\.?\\d*)\\s*(?P<unit>m|metres?|meters?)",
          "confidence": 0.7,
          "extraction_rules": {
            "distance_field": "distance",
            "unit_field": "unit",
            "calculation_type": "fixed"
          }
        }
      ],
      "conditional": [
        {
          "pattern": "(?P<min_distance>\\d+\\.?\\d*)\\s*m\\s+minimum\\s+OR\\s+(?P<multiplier>\\d+\\.?\\d*)\\s+times\\s+building\\s+height.*whichever\\s+is\\s+(?P<comparison>greater|lesser)",
          "confidence": 0.85,
          "extraction_rules": {
            "calculation_type": "conditional",
            "alternatives": [
              {"type": "fixed", "field": "min_distance"},
              {"type": "formula", "formula": "{multiplier} * building_height"}
            ],
            "selection_rule": "comparison"
          }
        },
        {
          "pattern": "side.*setback.*(?P<distance>\\d+\\.?\\d*)\\s*m.*adjoining.*(?P<adjoining_use>residential|commercial|industrial)",
          "confidence": 0.8,
          "extraction_rules": {
            "distance_field": "distance",
            "calculation_type": "fixed",
            "condition_type": "adjoining_use",
            "condition_field": "adjoining_use"
          }
        }
      ],
      "prohibitions": [
        {
          "pattern": "nil\\s+side\\s+setbacks.*not\\s+permitted",
          "confidence": 0.95,
          "extraction_rules": {
            "calculation_type": "minimum_required",
            "minimum_distance": 0.1,
            "exception": "nil_setback_prohibited"
          }
        }
      ]
    },
    "front": {
      "range": [
        {
          "pattern": "front\\s+setback.*between\\s+(?P<min_distance>\\d+\\.?\\d*)\\s*[–-]\\s*(?P<max_distance>\\d+\\.?\\d*)\\s*(?P<unit>m|metres?|meters?)",
          "confidence": 0.9,
          "extraction_rules": {
            "calculation_type": "range",
            "min_field": "min_distance",
            "max_field": "max_distance",
            "unit_field": "unit"
          }
        }
      ],
      "boundary_built": [
        {
          "pattern": "built\\s+to\\s+the\\s+front.*boundary",
          "confidence": 0.85,
          "extraction_rules": {
            "calculation_type": "fixed",
            "distance": 0,
            "condition_type": "location",
            "condition_value": "built_to_boundary"
          }
        }
      ],
      "consistency": [
        {
          "pattern": "consistent\\s+with.*adjoining\\s+(?P<consistency_type>setbacks?|buildings?)",
          "confidence": 0.75,
          "extraction_rules": {
            "calculation_type": "contextual",
            "consistency_field": "consistency_type"
          }
        }
      ]
    },
    "rear": {
      "height_limited": [
        {
          "pattern": "within\\s+(?P<distance>\\d+\\.?\\d*)\\s*m.*rear.*boundary.*height.*not\\s+exceed\\s+(?P<height_limit>\\d+\\.?\\d*)\\s*m",
          "confidence": 0.9,
          "extraction_rules": {
            "distance_field": "distance",
            "calculation_type": "fixed",
            "condition_type": "building_height",
            "condition_operator": "less_than",
            "condition_field": "height_limit"
          }
        }
      ],
      "fixed": [
        {
          "pattern": "rear\\s+setback.*?(?P<distance>\\d+\\.?\\d*)\\s*(?P<unit>m|metres?|meters?)",
          "confidence": 0.8,
          "extraction_rules": {
            "distance_field": "distance",
            "unit_field": "unit",
            "calculation_type": "fixed"
          }
        }
      ]
    }
  },
  "global_modifiers": {
    "zone_specific": [
      {
        "pattern": "(?P<zone_type>residential|commercial|industrial)\\s+zone",
        "extraction_rule": "zone_applicability"
      }
    ],
    "building_type": [
      {
        "pattern": "(?P<building_type>dwelling|house|apartment|commercial|industrial)\\s+building",
        "extraction_rule": "building_type_applicability"
      }
    ]
  },
  "confidence_adjustments": {
    "boost_conditions": [
      {"condition": "has_conditions", "adjustment": 0.1},
      {"condition": "has_calculations", "adjustment": 0.1},
      {"condition": "source_text_length > 50", "adjustment": 0.05}
    ],
    "reduce_conditions": [
      {"condition": "source_text_length < 20", "adjustment": -0.2},
      {"condition": "ambiguous_language", "adjustment": -0.15}
    ]
  }
}