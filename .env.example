# ===========================================================================
# PlotDetect / Compliance Engine — Environment Variables
# ===========================================================================
# Copy to .env (root) and frontend-nextjs/.env.local, fill in real values.
# NEVER commit real secrets. This file is safe to commit.
# See docs/CONFIGURATION.md for full documentation.
# ===========================================================================

# ── Database (Supabase) ─────────────────────────────────────────────────────
# Primary connection string (pooler mode). Used by the app.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Direct connection vars — used by some scripts
PGHOST=db.xxx.supabase.co
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGPORT=5432
# Alternative direct URL (non-pooler, for scripts only)
SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000

# ── Supabase Auth ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── API Keys (server-side only) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
GOOGLE_PLACES_API_KEY=AIza...
TFNSW_API_KEY=
ADMIN_API_KEY=
# Legacy — may be removable
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Cloudflare R2 (PDF page images) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET_NAME=plotdetect-evidence
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_MAPS_API_KEY=AIza...

# ── Redis (Upstash) ────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Telegram Alerts ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONVEYANCING_PRICE_ID=price_...
STRIPE_BUSHFIRE_PRICE_ID=price_...
STRIPE_FLOOD_TRUTH_PRICE_ID=price_...
STRIPE_GRANNY_FAT_PRICE_ID=price_...
STRIPE_SHADOW_PRICE_ID=price_...
STRIPE_SOLAR_YIELD_PRICE_ID=price_...
STRIPE_THREAT_RADAR_MONITOR_PRICE_ID=price_...
STRIPE_PRE_DA_HISTORY_PRICE_ID=price_...

# ── Feature Flags (NEXT_PUBLIC_ = baked at build time) ──────────────────────
NEXT_PUBLIC_DCP_ENABLED=true
NEXT_PUBLIC_ENABLED_LGAS=marrickville,leichhardt,ashfield,waverley,ku_ring_gai
NEXT_PUBLIC_BASE_URL=http://localhost:3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_SPATIAL_API_URL=http://localhost:8000
NEXT_PUBLIC_R2_BASE_URL=https://pub-7f3b945f2f0045d6991a6b9d6db51cd8.r2.dev
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_AUTH_ENABLED=false

# ── Server Feature Flags ───────────────────────────────────────────────────
# Migration-era flags — all should be true/v2 for current architecture
COMPLIANCE_ARCHITECTURE=v2
ENABLE_PRECINCT_MATCHING=true
USE_POSTGRESQL_PROVISIONS=true
USE_POSTGRESQL_TOD_RATES=true
USE_POSTGRESQL_VERSIONS=true
USE_POSTGRESQL_VERSION_COMPLIANCE=true
USE_POSTGRESQL_LIVE_CHECK=true

# ── Python API (Railway) ───────────────────────────────────────────────────
PYTHON_API_URL=http://localhost:8000
PORT=8000
ALLOWED_ORIGINS=http://localhost:3003

# ── Misc ────────────────────────────────────────────────────────────────────
REPORT_TOKEN_SECRET=
CRON_SECRET=
SLACK_WEBHOOK_URL=
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
