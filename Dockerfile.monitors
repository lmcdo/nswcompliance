FROM python:3.12-slim

WORKDIR /app

# Only psycopg2 needs build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-monitor.txt ./requirements-monitor.txt
RUN pip install --no-cache-dir -r requirements-monitor.txt
# Chrome for blocked councils (scripts/probe_blocked_councils.py); --with-deps adds its system libraries.
RUN python -m playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*

# Copy monitor scripts + hub scrapers
COPY scripts/satellite_freshness_monitor.py ./scripts/satellite_freshness_monitor.py
COPY scripts/legislation_monitor.py ./scripts/legislation_monitor.py
COPY scripts/pco_client.py ./scripts/pco_client.py
COPY scripts/regulatory_freshness_monitor.py ./scripts/regulatory_freshness_monitor.py
COPY scripts/r2_monitor.py ./scripts/r2_monitor.py
# Run results (migration 116) + the daily council-list diff; r2_monitor imports both.
COPY scripts/verifyops_record.py ./scripts/verifyops_record.py
COPY scripts/verifyops_links.py ./scripts/verifyops_links.py
COPY scripts/verifyops_classify.py ./scripts/verifyops_classify.py
COPY scripts/extract_dcp_stated_dates.py ./scripts/extract_dcp_stated_dates.py
# Deterministic content-change gate (text-hash) — r2_monitor imports it to reject
# re-export false positives.
COPY scripts/pdf_text_hash.py ./scripts/pdf_text_hash.py
COPY scripts/dcp_watchdog.py ./scripts/dcp_watchdog.py
COPY scripts/hub_scrapers/ ./scripts/hub_scrapers/
COPY scripts/run_monitors.py ./scripts/run_monitors.py
COPY scripts/probe_blocked_councils.py ./scripts/probe_blocked_councils.py
COPY scripts/probe_blocked_targets.json ./scripts/probe_blocked_targets.json

# Extract-to-review + commit-on-approve workers (MONITOR_NAME=dcp-extract / dcp-commit).
# These need pdfplumber (in requirements-monitor.txt) and the enrichment package,
# which dcp_extract_changed imports.
COPY scripts/dcp_extract_changed.py ./scripts/dcp_extract_changed.py
COPY scripts/dcp_commit_approved.py ./scripts/dcp_commit_approved.py
# dcp_commit_approved re-derives v2_precinct_id for each council it commits -- a
# committed provision is inserted with that field UNSET, exactly like the three
# enrichment fields, so without this the keys stay NULL until a human runs the
# derivation by hand (measured 2026-09-10: Ashfield down to 118 keyed rows of 2,041).
# The json is NOT optional: derive_precinct_keys reads it at MODULE level, so the
# import itself fails without it -- and a FileNotFoundError is not an ImportError.
COPY scripts/derive_precinct_keys.py ./scripts/derive_precinct_keys.py
# Reviewed never-serve rules: imported by derive_precinct_keys, gate_rules, dcp_extract_changed and enrichment.
# Without it every re-derive after a publish fails, for every council.
COPY scripts/never_serve.py ./scripts/never_serve.py
# gate_rules is imported by derive_precinct_keys at module level (DQ-146 gate rules),
# and it imports its two sibling rule files at module level in turn.
COPY scripts/gate_rules.py ./scripts/gate_rules.py
COPY scripts/gate_rules_roads.py ./scripts/gate_rules_roads.py
COPY scripts/gate_rules_areas.py ./scripts/gate_rules_areas.py
# The area-link guard. Both DCP workers import it at MODULE level (#1285); without
# this COPY dcp-extract and dcp-commit ImportError at start-up on every run.
COPY scripts/dcp_area_link_guard.py ./scripts/dcp_area_link_guard.py
COPY data/cos_precinct_page_ranges.json ./data/cos_precinct_page_ranges.json
# Sibling modules dcp_extract_changed imports at runtime: check_provision (review
# path) and check_gate (commit-path quality gate). Without these the worker
# ModuleNotFounds mid-run (review path crashed on verify_dcp_formatting).
COPY scripts/verify_dcp_formatting.py ./scripts/verify_dcp_formatting.py
COPY scripts/dcp_quality_report.py ./scripts/dcp_quality_report.py
# AI extraction engine (AI_EXTRACTION=1) — dcp_extract_changed imports it at runtime.
COPY scripts/ai_extractor.py ./scripts/ai_extractor.py
# The fail-closed page-map guard. dcp_extract_changed imports it at MODULE level
# and refuses a chapter whose hardcoded page ranges point past the end of its own
# PDF, so a missing COPY here is not a degraded check — it is an ImportError that
# stops the extract monitor dead.
COPY scripts/dcp_page_map_gate.py ./scripts/dcp_page_map_gate.py
# The contents parser used by ai_extractor.toc_codes_from_pdf (the coverage guard).
COPY scripts/dcp_toc_parse.py ./scripts/dcp_toc_parse.py
# The fidelity gate grades every row dcp-extract queues, and with it the citation
# proof and the check for pages the reader left out. dcp_extract_changed imports
# the gate lazily inside a try, so without these COPYs the grading was skipped
# with a one-line warning and Railway-queued rows arrived ungraded.
COPY scripts/dcp_fidelity_gate.py ./scripts/dcp_fidelity_gate.py
COPY scripts/verify_extraction_fidelity.py ./scripts/verify_extraction_fidelity.py
COPY scripts/citation_proof.py ./scripts/citation_proof.py
COPY scripts/pdf_picture_labels.py ./scripts/pdf_picture_labels.py
COPY scripts/page_coverage.py ./scripts/page_coverage.py
# dcp_commit_approved re-checks served citations after every publish (migration 076).
COPY scripts/dcp_citation_status.py ./scripts/dcp_citation_status.py
# ...and the setback controls' clause labels, which every report prints (migration 077).
COPY scripts/dcp_setback_citation_status.py ./scripts/dcp_setback_citation_status.py
COPY scripts/dq_probe_section_code_not_in_source.py ./scripts/dq_probe_section_code_not_in_source.py
# ...and every served rule's page link (migration 079). ai_extractor imports the locator too.
COPY scripts/dcp_page_repair.py ./scripts/dcp_page_repair.py
COPY scripts/rule_page_locator.py ./scripts/rule_page_locator.py
# dcp_page_repair --apply measures DQ-145 before it writes (dq_probe_live) and reads
# its ceiling after (outreach_claim_checks). Without these the subprocess exits
# before the write and dcp_commit_approved logs only a [warn]: links stay unchecked.
COPY scripts/dq_probe_live.py ./scripts/dq_probe_live.py
# dq_probe_live reads the chapters' scope files at MODULE level (a FileNotFoundError,
# which the import scan in tests/ cannot see).
COPY data/chapter_scope/ ./data/chapter_scope/
COPY scripts/dq_db.py ./scripts/dq_db.py
COPY scripts/qa_report_path.py ./scripts/qa_report_path.py
COPY scripts/outreach_claim_checks.py ./scripts/outreach_claim_checks.py
COPY scripts/outreach_flood_depth_probe.py ./scripts/outreach_flood_depth_probe.py
COPY scripts/outreach_scoped_councils.py ./scripts/outreach_scoped_councils.py
COPY scripts/dq_probe_applicability_config.py ./scripts/dq_probe_applicability_config.py
# verify_extraction_fidelity (the gate's grader) imports this at module level.
COPY services/extracted_data_integrity.py ./services/extracted_data_integrity.py
# dcp_commit_approved falls back to this to recover a section code from
# ref_number. Without it in the image the fallback quietly stops working and the
# codes start disappearing again on every commit -- the defect it exists to stop.
COPY scripts/dcp_section_code.py ./scripts/dcp_section_code.py
# The section-loss guard. Both DCP workers import it at MODULE level, and it imports
# dcp_chapter_measure for the one definition of a section code. A missing COPY here is
# an ImportError that stops both workers, not a quietly weaker check.
COPY scripts/dcp_supersede_guard.py ./scripts/dcp_supersede_guard.py
COPY scripts/dcp_chapter_measure.py ./scripts/dcp_chapter_measure.py
COPY enrichment/ ./enrichment/
# enrichment/pipeline.py imports load_ground_truth + load_slug_resolution from this
# checker to decide whether a derived zone code exists in the row's LGA (DQ-30).
# Without it the import fails, the guard degrades to a NO-OP, and retired codes are
# written again -- silently, because failing soft is the correct behaviour when the
# reference data cannot be read. Only stdlib beyond psycopg2, already present.
COPY scripts/validate_zone_code_validity.py ./scripts/validate_zone_code_validity.py

# Per-council completeness check -- dcp_commit_approved imports it at the end of
# every non-dry run, and it in turn SUBPROCESSES the two checkers below. All three
# must be present or the check degrades to a warning and nothing is compared,
# which is the same silence it exists to remove. audit_precinct_keying_coverage
# additionally loads derive_precinct_keys by path (COPYed above).
COPY scripts/check_council_completeness.py ./scripts/check_council_completeness.py
COPY scripts/council_completeness_rules.py ./scripts/council_completeness_rules.py
COPY scripts/audit_precinct_keying_coverage.py ./scripts/audit_precinct_keying_coverage.py

# Property-alerts dispatcher (MONITOR_NAME=property-alerts). It reuses the existing
# threat_radar subscription/check helpers, which live in the FastAPI router module
# services/threat_radar.py -> imports services/audit_trail.py. Both are copied here;
# fastapi is added to requirements-monitor.txt because importing that module pulls in
# APIRouter even in this non-web cron context.
COPY scripts/run_alerts_dispatch.py ./scripts/run_alerts_dispatch.py
COPY services/threat_radar.py ./services/threat_radar.py
COPY services/audit_trail.py ./services/audit_trail.py

ENV PYTHONPATH=/app:/app/scripts:/app/services
