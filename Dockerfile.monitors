FROM python:3.12-slim

WORKDIR /app

# Only psycopg2 needs build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-monitor.txt ./requirements-monitor.txt
RUN pip install --no-cache-dir -r requirements-monitor.txt

# Copy monitor scripts + hub scrapers
COPY scripts/satellite_freshness_monitor.py ./scripts/satellite_freshness_monitor.py
COPY scripts/legislation_monitor.py ./scripts/legislation_monitor.py
COPY scripts/pco_client.py ./scripts/pco_client.py
COPY scripts/regulatory_freshness_monitor.py ./scripts/regulatory_freshness_monitor.py
COPY scripts/r2_monitor.py ./scripts/r2_monitor.py
COPY scripts/dcp_watchdog.py ./scripts/dcp_watchdog.py
COPY scripts/hub_scrapers/ ./scripts/hub_scrapers/
COPY scripts/run_monitors.py ./scripts/run_monitors.py

# Extract-to-review + commit-on-approve workers (MONITOR_NAME=dcp-extract / dcp-commit).
# These need pdfplumber (in requirements-monitor.txt) and the enrichment package,
# which dcp_extract_changed imports.
COPY scripts/dcp_extract_changed.py ./scripts/dcp_extract_changed.py
COPY scripts/dcp_commit_approved.py ./scripts/dcp_commit_approved.py
# Sibling modules dcp_extract_changed imports at runtime: check_provision (review
# path) and check_gate (commit-path quality gate). Without these the worker
# ModuleNotFounds mid-run (review path crashed on verify_dcp_formatting).
COPY scripts/verify_dcp_formatting.py ./scripts/verify_dcp_formatting.py
COPY scripts/dcp_quality_report.py ./scripts/dcp_quality_report.py
COPY enrichment/ ./enrichment/

ENV PYTHONPATH=/app:/app/scripts
