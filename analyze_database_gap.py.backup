#!/usr/bin/env python3
"""
Systematic analysis of SQLite vs PostgreSQL databases
against Priority2Fix PRP requirements
"""

import sqlite3
import psycopg2
from db_config import get_connection
import json

def analyze_sqlite_db():
    """Analyze SQLite database comprehensively"""
    conn = sqlite3.connect('nsw_planning.db')
    cursor = conn.cursor()

    # Get all tables
    cursor.execute("SELECT name FROM sqlite_master WHERE type='table'")
    tables = [row[0] for row in cursor.fetchall()]

    analysis = {
        'total_tables': len(tables),
        'tables': tables,
        'key_data_counts': {}
    }

    # Critical tables for Priority2Fix PRPs
    priority_tables = [
        'regulatory_provisions',
        'sepp_provisions',
        'lep_provisions',
        'development_controls',
        'quantitative_standards',
        'development_pathways',
        'development_permissions',
        'contextual_guidance'
    ]

    for table in priority_tables:
        if table in tables:
            cursor.execute(f'SELECT COUNT(*) FROM {table}')
            count = cursor.fetchone()[0]
            analysis['key_data_counts'][table] = count

            # Sample data structure
            cursor.execute(f'PRAGMA table_info({table})')
            columns = [col[1] for col in cursor.fetchall()]
            analysis[f'{table}_columns'] = columns
        else:
            analysis['key_data_counts'][table] = 0

    conn.close()
    return analysis

def analyze_postgresql_db():
    """Analyze PostgreSQL database comprehensively"""
    conn = get_connection()
    cursor = conn.cursor()

    # Get all tables
    cursor.execute("SELECT table_name FROM information_schema.tables WHERE table_schema = 'public'")
    tables = [row[0] for row in cursor.fetchall()]

    analysis = {
        'total_tables': len(tables),
        'tables': tables,
        'key_data_counts': {}
    }

    # Critical tables for Priority2Fix PRPs
    priority_tables = [
        'regulatory_provisions',
        'sepp_provisions',
        'lep_provisions',
        'development_controls',
        'quantitative_standards',
        'development_pathways',
        'development_permissions',
        'contextual_guidance'
    ]

    for table in priority_tables:
        if table in tables:
            cursor.execute(f'SELECT COUNT(*) FROM {table}')
            count = cursor.fetchone()[0]
            analysis['key_data_counts'][table] = count

            # Sample data structure
            cursor.execute(f'''
                SELECT column_name
                FROM information_schema.columns
                WHERE table_name = %s AND table_schema = 'public'
            ''', (table,))
            columns = [row[0] for row in cursor.fetchall()]
            analysis[f'{table}_columns'] = columns
        else:
            analysis['key_data_counts'][table] = 0

    conn.close()
    return analysis

def check_priority2fix_requirements():
    """Check what Priority2Fix PRPs need from database"""

    requirements = {
        'PRP-Q1_Live_Compliance_Calculator': {
            'needs': [
                'regulatory_provisions (for FSR/height rules)',
                'development_controls (for setback calculations)',
                'quantitative_standards (for numerical limits)',
                'NSW API integration (already exists)'
            ],
            'critical_data': ['FSR limits', 'height limits', 'setback rules']
        },
        'PRP-Q2_Development_Pathway_Intelligence': {
            'needs': [
                'sepp_provisions (2,186+ exempt/complying rules)',
                'lep_provisions (4,481+ LEP provisions)',
                'development_pathways (DA/CDC logic)',
                'development_permissions (pathway mapping)'
            ],
            'critical_data': ['SEPP exempt rules', 'SEPP complying rules', 'LEP zones']
        },
        'PRP-Q3_Advanced_Compliance_Rules': {
            'needs': [
                'regulatory_provisions (complex rules)',
                'quantitative_standards (multi-factor calcs)',
                'development_controls (site coverage, parking)',
                'contextual_guidance (landscaping rules)'
            ],
            'critical_data': ['Site coverage rules', 'Parking requirements', 'Landscaping rules']
        },
        'PRP-Q4_Legal_Disclaimers': {
            'needs': [
                'API monitoring framework',
                'Data currency tracking',
                'Legal disclaimer system'
            ],
            'critical_data': ['API health status', 'Data freshness timestamps']
        }
    }

    return requirements

def main():
    print("=== SYSTEMATIC DATABASE ANALYSIS vs PRIORITY2FIX PRPs ===\n")

    # Analyze both databases
    sqlite_analysis = analyze_sqlite_db()
    postgresql_analysis = analyze_postgresql_db()
    priority_requirements = check_priority2fix_requirements()

    print("1. DATABASE COMPARISON:")
    print(f"   SQLite: {sqlite_analysis['total_tables']} tables")
    print(f"   PostgreSQL: {postgresql_analysis['total_tables']} tables")

    print("\n2. CRITICAL DATA AVAILABILITY:")

    critical_tables = ['regulatory_provisions', 'sepp_provisions', 'lep_provisions',
                      'development_controls', 'quantitative_standards',
                      'development_pathways', 'development_permissions']

    for table in critical_tables:
        sqlite_count = sqlite_analysis['key_data_counts'].get(table, 0)
        postgres_count = postgresql_analysis['key_data_counts'].get(table, 0)

        status = "MISSING" if sqlite_count == 0 and postgres_count == 0 else "AVAILABLE"
        if sqlite_count > 0 and postgres_count == 0:
            status = "MIGRATION_NEEDED"
        elif sqlite_count > 0 and postgres_count > 0:
            status = "BOTH_EXIST"

        print(f"   {table}:")
        print(f"     SQLite: {sqlite_count:,} | PostgreSQL: {postgres_count:,} | Status: {status}")

    print("\n3. PRIORITY2FIX PRP READINESS:")

    for prp, requirements in priority_requirements.items():
        print(f"\n   {prp}:")
        readiness_score = 0
        total_requirements = len(requirements['needs'])

        for need in requirements['needs']:
            table_name = need.split(' ')[0]  # Extract table name
            if table_name in critical_tables:
                sqlite_has = sqlite_analysis['key_data_counts'].get(table_name, 0) > 0
                postgres_has = postgresql_analysis['key_data_counts'].get(table_name, 0) > 0
                if sqlite_has or postgres_has:
                    readiness_score += 1
                    print(f"     OK {need}")
                else:
                    print(f"     MISSING {need}")
            else:
                print(f"     ? {need} (external dependency)")
                readiness_score += 0.5  # Partial credit for external deps

        readiness_percent = (readiness_score / total_requirements) * 100
        print(f"     Readiness: {readiness_percent:.0f}%")

    print("\n4. MIGRATION ANALYSIS:")

    migration_needed = []
    for table in critical_tables:
        sqlite_count = sqlite_analysis['key_data_counts'].get(table, 0)
        postgres_count = postgresql_analysis['key_data_counts'].get(table, 0)

        if sqlite_count > 0 and postgres_count == 0:
            migration_needed.append({
                'table': table,
                'records': sqlite_count,
                'priority': 'HIGH' if table in ['sepp_provisions', 'lep_provisions'] else 'MEDIUM'
            })

    if migration_needed:
        print("   MIGRATION REQUIRED:")
        for item in migration_needed:
            print(f"     {item['table']}: {item['records']:,} records ({item['priority']} priority)")
    else:
        print("   OK No migration needed - data exists in PostgreSQL")

    print("\n5. RECOMMENDATIONS:")

    if migration_needed:
        print("   1. Execute data migration from SQLite to PostgreSQL")
        print("   2. Verify data integrity after migration")
        print("   3. Update all services to use PostgreSQL only")
        print("   4. Execute Priority2Fix PRPs in sequence")
    else:
        print("   1. Data foundation is ready")
        print("   2. Begin Priority2Fix PRP execution immediately")
        print("   3. Focus on live API integration enhancement")

    # Save detailed analysis
    analysis_report = {
        'sqlite': sqlite_analysis,
        'postgresql': postgresql_analysis,
        'requirements': priority_requirements,
        'migration_needed': migration_needed,
        'timestamp': '2025-09-20'
    }

    with open('database_gap_analysis.json', 'w') as f:
        json.dump(analysis_report, f, indent=2)

    print(f"\n   Detailed analysis saved to: database_gap_analysis.json")

if __name__ == "__main__":
    main()