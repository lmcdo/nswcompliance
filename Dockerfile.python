FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    # GDAL — required by rasterio and geopandas
    libgdal-dev \
    gdal-bin \
    python3-gdal \
    # HDF5 — required by netCDF4 for NARCliM raster sampling
    libhdf5-dev \
    # proj — coordinate transforms
    libproj-dev \
    proj-data \
    proj-bin \
    # geo runtime libs
    libgeos-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY services/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code + startup scripts
COPY services/ ./services/
COPY scripts/download_hawkesbury_rasters.py ./scripts/download_hawkesbury_rasters.py
COPY scripts/download_narclim_rasters.py ./scripts/download_narclim_rasters.py
COPY scripts/generate_conveyancing_report.py ./scripts/generate_conveyancing_report.py
COPY scripts/conveyancing_db.py ./scripts/conveyancing_db.py
# brief drift-check cron (railway.brief-drift.toml runs this image)
COPY scripts/run_brief_drift_check.py ./scripts/run_brief_drift_check.py
COPY scripts/brief_contract_drift.py ./scripts/brief_contract_drift.py
COPY scripts/run_monitors.py ./scripts/run_monitors.py

# compliance_api_server.py imports enhanced_compliance_api without 'services.' prefix
# (it runs locally from services/), so add services/ to PYTHONPATH as well
ENV PYTHONPATH=/app:/app/services:/app/scripts

# Hawkesbury rasters downloaded to /tmp at startup (writable, persists for container lifetime)
ENV HAWKESBURY_RASTER_DIR=/tmp/hawkesbury_rasters
# NARCliM climate-projection NetCDFs downloaded to /tmp at startup (same pattern);
# climate_risk_raster.py reads the same NARCLIM_DIR.
ENV NARCLIM_DIR=/tmp/narclim

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["sh", "-c", "python3 scripts/download_hawkesbury_rasters.py && python3 scripts/download_narclim_rasters.py && uvicorn services.compliance_api_server:app --host 0.0.0.0 --port 8000"]
