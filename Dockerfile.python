FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    # GDAL — required by rasterio and geopandas
    libgdal-dev \
    gdal-bin \
    python3-gdal \
    # proj — coordinate transforms
    libproj-dev \
    proj-data \
    proj-bin \
    # geo runtime libs
    libgeos-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY services/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code + startup scripts
COPY services/ ./services/
COPY scripts/download_hawkesbury_rasters.py ./scripts/download_hawkesbury_rasters.py
COPY scripts/generate_conveyancing_report.py ./scripts/generate_conveyancing_report.py
COPY scripts/conveyancing_db.py ./scripts/conveyancing_db.py

# compliance_api_server.py imports enhanced_compliance_api without 'services.' prefix
# (it runs locally from services/), so add services/ to PYTHONPATH as well
ENV PYTHONPATH=/app:/app/services:/app/scripts

# Hawkesbury rasters downloaded to /tmp at startup (writable, persists for container lifetime)
ENV HAWKESBURY_RASTER_DIR=/tmp/hawkesbury_rasters

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["sh", "-c", "python3 scripts/download_hawkesbury_rasters.py && uvicorn services.compliance_api_server:app --host 0.0.0.0 --port 8000"]
