FROM python:3.12-slim

WORKDIR /app

# System deps for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    # GDAL — required by rasterio and geopandas
    libgdal-dev \
    gdal-bin \
    python3-gdal \
    # HDF5 — required by netCDF4 for NARCliM raster sampling
    libhdf5-dev \
    # proj — coordinate transforms
    libproj-dev \
    proj-data \
    proj-bin \
    # geo runtime libs
    libgeos-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY services/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code + startup scripts
COPY services/ ./services/
COPY scripts/download_hawkesbury_rasters.py ./scripts/download_hawkesbury_rasters.py
COPY scripts/download_redbank_rasters.py ./scripts/download_redbank_rasters.py
COPY scripts/download_tweed_wollongong_rasters.py ./scripts/download_tweed_wollongong_rasters.py
COPY scripts/download_narclim_rasters.py ./scripts/download_narclim_rasters.py
COPY scripts/generate_conveyancing_report.py ./scripts/generate_conveyancing_report.py
COPY scripts/conveyancing_db.py ./scripts/conveyancing_db.py
# brief drift-check cron (railway.brief-drift.toml runs this image)
COPY scripts/run_brief_drift_check.py ./scripts/run_brief_drift_check.py
COPY scripts/brief_contract_drift.py ./scripts/brief_contract_drift.py
COPY scripts/run_monitors.py ./scripts/run_monitors.py

# compliance_api_server.py imports enhanced_compliance_api without 'services.' prefix
# (it runs locally from services/), so add services/ to PYTHONPATH as well
ENV PYTHONPATH=/app:/app/services:/app/scripts

# Hawkesbury rasters downloaded to /tmp at startup (writable, persists for container lifetime)
ENV HAWKESBURY_RASTER_DIR=/tmp/hawkesbury_rasters
# Redbank Creek FS 2025 rasters — same pattern (224 MB compressed GeoTIFFs)
ENV REDBANK_RASTER_DIR=/tmp/redbank_rasters
# Tweed + Wollongong — same pattern. These two were MISSING until 2026-08-24, and
# their absence was not inert: download_tweed_wollongong_rasters.py falls back to
# /tmp/<study>_rasters while services/flood_truth.py falls back to
# data/flood_studies/<study>, which is gitignored and never COPY'd into the image.
# So the CMD below downloaded 1.6 GB on every cold start into two directories
# nothing then read, and every Tweed/Wollongong 1% AEP answer came back
# "not assessed". Writer and reader now agree because both are pinned here.
ENV TWEED_RASTER_DIR=/tmp/tweed_rasters
ENV WOLLONGONG_RASTER_DIR=/tmp/wollongong_rasters
# NARCliM climate-projection NetCDFs downloaded to /tmp at startup (same pattern);
# climate_risk_raster.py reads the same NARCLIM_DIR.
ENV NARCLIM_DIR=/tmp/narclim

EXPOSE 8000

# start-period must exceed a COLD start, and the CMD below downloads ~2.5 GB of
# rasters before uvicorn binds a port. Measured cold start 2026-08-07: 37s
# (05:57:13 container start -> 05:57:50 "Application startup complete"), of
# which ~35s is the three downloaders. A warm restart is ~2s, because each
# downloader skips files already present at the right size.
#
# 10s was therefore 27s SHORT of a healthy boot. It survived only on the retry
# margin (10s + 3x30s = ~100s before unhealthy) — luck, not design.
#
# 300s covers roughly a 7x degradation of the observed ~70 MB/s throughput, and
# is close to free: a start-period ENDS the moment one probe succeeds, so a fast
# boot is marked healthy at the first check and the longer window costs nothing.
# The asymmetry justifies the generosity — too short kills a container
# mid-download, which restarts and re-downloads 2.5 GB (a crash loop); too long
# only delays noticing a genuinely dead container.
#
# NOTE: Railway gates deployments on its own `healthcheckPath` setting, which is
# NOT configured for this service, so this instruction may currently be inert
# there. It is still wrong as written and is honoured by plain `docker run`,
# Compose and other runtimes — see the PR for the healthcheckPath question.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["sh", "-c", "python3 scripts/download_hawkesbury_rasters.py && python3 scripts/download_redbank_rasters.py && python3 scripts/download_tweed_wollongong_rasters.py && python3 scripts/download_narclim_rasters.py && uvicorn services.compliance_api_server:app --host 0.0.0.0 --port 8000"]
