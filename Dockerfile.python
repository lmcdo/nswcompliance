FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY services/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code
COPY services/ ./services/

# compliance_api_server.py imports enhanced_compliance_api without 'services.' prefix
# (it runs locally from services/), so add services/ to PYTHONPATH as well
ENV PYTHONPATH=/app:/app/services

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "services.compliance_api_server:app", "--host", "0.0.0.0", "--port", "8000"]
