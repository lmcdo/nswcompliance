      <data key="d6">9.0</data>
      <data key="d7">"Parking Requirements delineate the minimum number of parking spaces for residential development."}</data>
      <data key="d8">development standards,regulatory compliance</data>
      <data key="d9">chunk-fddb9a116002f5fba7900393df558bd9</data>
      <data key="d10">Inner_West_LEP_2022.pdf</data>
