#!/usr/bin/env bash
# pre-push hook — runs automatically on every git push.
# Blocks push if:
#   - Python enrichment tests fail
#   - TypeScript error count exceeds baseline
#   - Smoke tests fail (skipped gracefully if dev server not running)
# To bypass in an emergency: git push --no-verify (document why in the commit message)

set -uo pipefail

TSC_BASELINE=0
REPO_ROOT="$(git rev-parse --show-toplevel)"
FRONTEND_DIR="$REPO_ROOT/frontend-nextjs"

# ── Python: enrichment tests ─────────────────────────────────────────────────
echo "pytest: running enrichment tests..."
if python -m pytest "$REPO_ROOT/tests/enrichment/" -q --tb=short 2>&1; then
  echo "✅ pytest passed"
else
  echo ""
  echo "❌ pytest FAILED — fix failing tests before pushing"
  exit 1
fi

# ── TypeScript gate ───────────────────────────────────────────────────────────
if [ ! -d "$FRONTEND_DIR" ]; then
  echo "tsc-gate: frontend-nextjs not found, skipping"
else
  echo "tsc-gate: counting TypeScript errors..."
  COUNT=$(cd "$FRONTEND_DIR" && npx tsc --noEmit --skipLibCheck 2>&1 | grep -c "error TS" || true)

  if [ "$COUNT" -gt "$TSC_BASELINE" ]; then
    echo ""
    echo "❌ tsc-gate FAILED: $COUNT errors (baseline $TSC_BASELINE, +$((COUNT - TSC_BASELINE)) new)"
    echo "   Fix new TypeScript errors before pushing."
    echo "   Run: cd frontend-nextjs && npx tsc --noEmit --skipLibCheck 2>&1 | grep 'error TS'"
    exit 1
  fi

  echo "✅ tsc-gate passed: $COUNT errors (baseline $TSC_BASELINE)"
fi

# ── ESLint gate ──────────────────────────────────────────────────────────────
if [ -d "$FRONTEND_DIR" ]; then
  echo "eslint: running next lint..."
  LINT_ERRORS=$(cd "$FRONTEND_DIR" && npx next lint 2>&1 | grep -c "^.*  Error:" || true)

  if [ "${LINT_ERRORS:-0}" -gt 0 ]; then
    echo ""
    echo "❌ eslint FAILED: $LINT_ERRORS error(s)"
    echo "   Run: cd frontend-nextjs && npx next lint"
    exit 1
  fi

  echo "✅ eslint passed (warnings allowed)"
fi


# ── Jest: frontend unit tests ─────────────────────────────────────────────────
if [ -d "$FRONTEND_DIR" ]; then
  echo "jest: running frontend unit tests..."
  JEST_COUNT=$(cd "$FRONTEND_DIR" && npx jest --no-coverage --forceExit --passWithNoTests 2>&1 | grep -E "^Tests:" | tail -1)
  FAILED=$(echo "$JEST_COUNT" | grep -o '[0-9]* failed' | grep -o '[0-9]*' || echo "0")

  if [ "${FAILED:-0}" -gt 0 ]; then
    echo ""
    echo "❌ jest FAILED: $FAILED test(s) failing"
    echo "   Run: cd frontend-nextjs && npx jest --no-coverage to see failures"
    exit 1
  fi

  echo "✅ jest passed: $JEST_COUNT"
fi

# ── Smoke tests ───────────────────────────────────────────────────────────────
# Skips gracefully if dev server not running on :3003
bash "$REPO_ROOT/scripts/smoke_test.sh"
exit $?
