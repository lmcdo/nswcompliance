#!/usr/bin/env python3
"""
PRP-H3: Real-Time Error Monitoring and Validation System
Comprehensive error detection, reporting, and recovery validation
"""
import os
import json
import sqlite3
import time
from typing import Dict, List, Any, Optional, Tuple
from pathlib import Path
import logging

class ComprehensiveErrorMonitor:
    """Real-time error monitoring and validation system for extraction modules"""
    
    def __init__(self):
        self.base_path = Path("C:/Users/lawre/Downloads/solvyra/projects/compliance engine/compliance-engine")
        self.db_path = self.base_path / "nsw_planning_data.db"
        
        # Setup logging
        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
        self.logger = logging.getLogger(__name__)
        
        # Initialize monitoring results
        self.monitoring_results = {
            'validation_checks': 0,
            'errors_detected': 0,
            'data_integrity_issues': 0,
            'recovery_actions': 0,
            'success_rate': 0.0,
            'critical_issues': [],
            'warnings': [],
            'recommendations': []
        }
        
    def validate_h1_llamaindex_results(self) -> Dict:
        """Validate PRP-H1 LlamaIndex extraction results"""
        print("Validating PRP-H1 LlamaIndex results...")
        
        validation_result = {
            'module': 'PRP-H1',
            'status': 'unknown',
            'issues_found': [],
            'data_quality_score': 0,
            'recommendations': []
        }
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Check if llamaindex_extracts table exists and has data
            cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='llamaindex_extracts'")
            table_exists = cursor.fetchone() is not None
            
            if not table_exists:
                validation_result['status'] = 'CRITICAL_FAILURE'
                validation_result['issues_found'].append("No llamaindex_extracts table found")
                validation_result['recommendations'].append("Re-run PRP-H1 with database creation")
                return validation_result
                
            # Check data counts
            cursor.execute("SELECT COUNT(*) FROM llamaindex_extracts")
            total_extracts = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM llamaindex_extracts WHERE extract_type = 'measurement'")
            measurements = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM llamaindex_extracts WHERE extract_type = 'zone'")
            zones = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM llamaindex_extracts WHERE extract_type = 'condition'")
            conditions = cursor.fetchone()[0]
            
            conn.close()
            
            # Evaluate results
            validation_result.update({
                'total_extracts': total_extracts,
                'measurements_found': measurements,
                'zones_found': zones,
                'conditions_found': conditions
            })
            
            # Critical assessment
            if measurements == 0:
                validation_result['status'] = 'CRITICAL_ISSUE'
                validation_result['issues_found'].append("Zero measurements extracted - major data loss")
                validation_result['recommendations'].append("Use RAGFlow/MinerU for measurement extraction")
            elif total_extracts < 50:
                validation_result['status'] = 'INSUFFICIENT_DATA'
                validation_result['issues_found'].append("Low extraction count suggests incomplete processing")
            else:
                validation_result['status'] = 'ACCEPTABLE'
                
            validation_result['data_quality_score'] = min(100, (total_extracts / 100) * 100)
            
        except Exception as e:
            validation_result['status'] = 'VALIDATION_ERROR'
            validation_result['issues_found'].append(f"Database validation error: {e}")
            
        self.monitoring_results['validation_checks'] += 1
        if validation_result['issues_found']:
            self.monitoring_results['errors_detected'] += len(validation_result['issues_found'])
            
        return validation_result
        
    def validate_h2_ragflow_results(self) -> Dict:
        """Validate PRP-H2 RAGFlow extraction results"""
        print("Validating PRP-H2 RAGFlow results...")
        
        validation_result = {
            'module': 'PRP-H2',
            'status': 'unknown',
            'issues_found': [],
            'data_quality_score': 0,
            'recommendations': []
        }
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Check if ragflow_measurements table exists
            cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='ragflow_measurements'")
            table_exists = cursor.fetchone() is not None
            
            if not table_exists:
                validation_result['status'] = 'CRITICAL_FAILURE'
                validation_result['issues_found'].append("No ragflow_measurements table found")
                return validation_result
                
            # Get detailed statistics
            cursor.execute("SELECT COUNT(*) FROM ragflow_measurements")
            total_measurements = cursor.fetchone()[0]
            
            cursor.execute("""
                SELECT measurement_type, COUNT(*) 
                FROM ragflow_measurements 
                GROUP BY measurement_type
            """)
            type_distribution = dict(cursor.fetchall())
            
            # Check for data quality issues
            cursor.execute("SELECT COUNT(*) FROM ragflow_measurements WHERE value IS NULL OR value <= 0")
            invalid_values = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM ragflow_measurements WHERE context IS NULL OR context = ''")
            missing_context = cursor.fetchone()[0]
            
            conn.close()
            
            # Evaluate results
            validation_result.update({
                'total_measurements': total_measurements,
                'type_distribution': type_distribution,
                'invalid_values': invalid_values,
                'missing_context': missing_context
            })
            
            # Critical assessment
            if total_measurements >= 5000:
                validation_result['status'] = 'EXCELLENT'
                validation_result['data_quality_score'] = 95
            elif total_measurements >= 1000:
                validation_result['status'] = 'GOOD'
                validation_result['data_quality_score'] = 80
            elif total_measurements >= 100:
                validation_result['status'] = 'ACCEPTABLE'
                validation_result['data_quality_score'] = 60
            else:
                validation_result['status'] = 'INSUFFICIENT'
                validation_result['data_quality_score'] = 30
                validation_result['issues_found'].append("Insufficient measurement extraction")
                
            # Check for data quality issues
            if invalid_values > total_measurements * 0.1:  # More than 10% invalid
                validation_result['issues_found'].append(f"High invalid value rate: {invalid_values}/{total_measurements}")
                
            if missing_context > total_measurements * 0.2:  # More than 20% missing context
                validation_result['issues_found'].append(f"High missing context rate: {missing_context}/{total_measurements}")
                
            # Check type distribution
            key_types = ['setback', 'height', 'fsr', 'site_coverage']
            missing_types = [t for t in key_types if t not in type_distribution or type_distribution[t] < 10]
            if missing_types:
                validation_result['issues_found'].append(f"Low counts for key types: {missing_types}")
                
        except Exception as e:
            validation_result['status'] = 'VALIDATION_ERROR'
            validation_result['issues_found'].append(f"Database validation error: {e}")
            
        self.monitoring_results['validation_checks'] += 1
        if validation_result['issues_found']:
            self.monitoring_results['errors_detected'] += len(validation_result['issues_found'])
            
        return validation_result
        
    def check_data_integration_consistency(self) -> Dict:
        """Check consistency between different extraction modules"""
        print("Checking data integration consistency...")
        
        integration_result = {
            'status': 'unknown',
            'consistency_issues': [],
            'overlap_analysis': {},
            'recommendations': []
        }
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Check if both tables exist
            cursor.execute("""
                SELECT name FROM sqlite_master 
                WHERE type='table' AND name IN ('llamaindex_extracts', 'ragflow_measurements')
            """)
            existing_tables = [row[0] for row in cursor.fetchall()]
            
            if len(existing_tables) < 2:
                integration_result['consistency_issues'].append(
                    f"Missing extraction tables. Found: {existing_tables}"
                )
                integration_result['status'] = 'INCOMPLETE'
                conn.close()
                return integration_result
                
            # Analyze overlap and gaps
            cursor.execute("SELECT COUNT(*) FROM llamaindex_extracts WHERE extract_type = 'measurement'")
            h1_measurements = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM ragflow_measurements")
            h2_measurements = cursor.fetchone()[0]
            
            integration_result['overlap_analysis'] = {
                'h1_measurements': h1_measurements,
                'h2_measurements': h2_measurements,
                'total_unique_measurements': h1_measurements + h2_measurements,  # Simplified
                'coverage_ratio': h2_measurements / max(1, h1_measurements + h2_measurements)
            }
            
            # Assess integration quality
            if h1_measurements == 0 and h2_measurements > 1000:
                integration_result['status'] = 'COMPLEMENTARY'
                integration_result['recommendations'].append("H2 successfully compensates for H1 measurement gap")
            elif h1_measurements > 0 and h2_measurements > 0:
                integration_result['status'] = 'SYNERGISTIC'
                integration_result['recommendations'].append("Both modules contributing data - good coverage")
            else:
                integration_result['status'] = 'PROBLEMATIC'
                integration_result['consistency_issues'].append("Insufficient data from both modules")
                
            conn.close()
            
        except Exception as e:
            integration_result['status'] = 'ERROR'
            integration_result['consistency_issues'].append(f"Integration check failed: {e}")
            
        self.monitoring_results['validation_checks'] += 1
        if integration_result['consistency_issues']:
            self.monitoring_results['data_integrity_issues'] += len(integration_result['consistency_issues'])
            
        return integration_result
        
    def generate_performance_metrics(self) -> Dict:
        """Generate comprehensive performance metrics"""
        print("Generating performance metrics...")
        
        metrics = {
            'extraction_efficiency': {},
            'data_coverage': {},
            'quality_scores': {},
            'system_health': 'unknown'
        }
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Get file processing stats
            cursor.execute("SELECT COUNT(DISTINCT source_file) FROM ragflow_measurements")
            files_processed = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM ragflow_measurements")
            total_extractions = cursor.fetchone()[0]
            
            # Calculate efficiency metrics
            if files_processed > 0:
                extractions_per_file = total_extractions / files_processed
                metrics['extraction_efficiency'] = {
                    'files_processed': files_processed,
                    'total_extractions': total_extractions,
                    'extractions_per_file': extractions_per_file,
                    'efficiency_rating': 'HIGH' if extractions_per_file > 100 else 'MEDIUM' if extractions_per_file > 20 else 'LOW'
                }
                
            # Data coverage analysis
            cursor.execute("""
                SELECT measurement_type, COUNT(*) as count,
                       AVG(value) as avg_value, 
                       MIN(value) as min_value, 
                       MAX(value) as max_value
                FROM ragflow_measurements 
                GROUP BY measurement_type
            """)
            coverage_data = {}
            for row in cursor.fetchall():
                coverage_data[row[0]] = {
                    'count': row[1],
                    'avg_value': row[2],
                    'min_value': row[3],
                    'max_value': row[4]
                }
            metrics['data_coverage'] = coverage_data
            
            # Overall system health
            total_data_points = sum([data['count'] for data in coverage_data.values()])
            key_types_coverage = len([t for t in ['setback', 'height', 'fsr'] if t in coverage_data and coverage_data[t]['count'] > 50])
            
            if total_data_points > 5000 and key_types_coverage >= 2:
                metrics['system_health'] = 'EXCELLENT'
            elif total_data_points > 1000 and key_types_coverage >= 1:
                metrics['system_health'] = 'GOOD'
            elif total_data_points > 100:
                metrics['system_health'] = 'ACCEPTABLE'
            else:
                metrics['system_health'] = 'NEEDS_IMPROVEMENT'
                
            conn.close()
            
        except Exception as e:
            metrics['error'] = str(e)
            metrics['system_health'] = 'ERROR'
            
        return metrics
        
    def run_comprehensive_monitoring(self) -> Dict:
        """Run complete error monitoring and validation suite"""
        print("=" * 60)
        print("PRP-H3: COMPREHENSIVE ERROR MONITORING SYSTEM")
        print("=" * 60)
        print("Real-time validation of extraction pipeline integrity")
        print()
        
        start_time = time.time()
        
        # Run all validation checks
        h1_validation = self.validate_h1_llamaindex_results()
        h2_validation = self.validate_h2_ragflow_results()
        integration_check = self.check_data_integration_consistency()
        performance_metrics = self.generate_performance_metrics()
        
        # Calculate overall success rate
        total_checks = 3  # H1, H2, Integration
        successful_checks = sum([
            1 if h1_validation['status'] in ['ACCEPTABLE', 'GOOD', 'EXCELLENT'] else 0,
            1 if h2_validation['status'] in ['ACCEPTABLE', 'GOOD', 'EXCELLENT'] else 0,
            1 if integration_check['status'] in ['COMPLEMENTARY', 'SYNERGISTIC'] else 0
        ])
        
        self.monitoring_results['success_rate'] = (successful_checks / total_checks) * 100
        execution_time = time.time() - start_time
        
        # Compile final results
        final_results = {
            'monitoring_summary': self.monitoring_results,
            'h1_validation': h1_validation,
            'h2_validation': h2_validation,
            'integration_analysis': integration_check,
            'performance_metrics': performance_metrics,
            'execution_time_seconds': execution_time,
            'timestamp': time.strftime('%Y-%m-%d %H:%M:%S')
        }
        
        # Print comprehensive results
        print("VALIDATION RESULTS:")
        print("=" * 40)
        print(f"PRP-H1 Status: {h1_validation['status']}")
        print(f"  - Measurements: {h1_validation.get('measurements_found', 0)}")
        print(f"  - Total extracts: {h1_validation.get('total_extracts', 0)}")
        
        print(f"\nPRP-H2 Status: {h2_validation['status']}")
        print(f"  - Measurements: {h2_validation.get('total_measurements', 0)}")
        print(f"  - Data quality: {h2_validation.get('data_quality_score', 0)}%")
        
        print(f"\nIntegration Status: {integration_check['status']}")
        print(f"System Health: {performance_metrics.get('system_health', 'UNKNOWN')}")
        
        print(f"\nOverall Success Rate: {self.monitoring_results['success_rate']:.1f}%")
        print(f"Monitoring Time: {execution_time:.2f} seconds")
        
        # Critical recommendations
        print("\nCRITICAL RECOMMENDATIONS:")
        if h2_validation.get('total_measurements', 0) > 5000:
            print("SUCCESS: RAGFlow extraction compensated for LlamaIndex gaps")
        if integration_check['status'] == 'COMPLEMENTARY':
            print("SUCCESS: Hybrid approach working - H2 fills H1 measurement gap")
        
        return final_results

def main():
    """Execute PRP-H3 comprehensive error monitoring"""
    monitor = ComprehensiveErrorMonitor()
    results = monitor.run_comprehensive_monitoring()
    
    # Save detailed results
    results_file = Path("PRP_H3_MONITORING_RESULTS.json")
    with open(results_file, 'w') as f:
        json.dump(results, f, indent=2, default=str)
    
    print(f"\nDetailed monitoring results saved to: {results_file}")

if __name__ == "__main__":
    main()