# Per-Dockerfile ignore for Dockerfile.maintenance (BuildKit uses this INSTEAD
# of .dockerignore, not in addition to it). Mirrors .dockerignore but KEEPS the
# tests/ directory, which Dockerfile.maintenance copies in (step COPY tests/)
# so the mutation-health job can run pytest. Everything else is still excluded
# to keep the build context small.

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
dist/

# Environment files (use secrets management instead)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation and development files
README.md
PLANNING.md
TASK.md
CLAUDE.md
documentation/

# Test files
# NOTE: tests/ is intentionally NOT excluded here — Dockerfile.maintenance
# needs it for the mutation-health / pytest run.
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
__tests__/
coverage/

# Development tools
eslint.config.js
jest.config.js
playwright.config.ts

# Logs
logs/
*.log

# Database backups (handled by cloud storage)
backups/
*.sql
*.dump

# Cache directories
.cache/
.parcel-cache/

# Temporary files
tmp/
temp/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# Build artifacts
build/
dist/

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Cloud deployment
kubernetes/
k8s/
helm/

# Local development
.env.example
