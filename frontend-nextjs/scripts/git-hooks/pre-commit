#!/bin/bash

# PlotDetect Documentation Reminder Hook
# Reminds developer to update ARCHITECTURE.md and FEATURES_CAPABILITIES.md
# when significant code changes are detected

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check if docs were already updated
DOCS_UPDATED=false
if echo "$STAGED_FILES" | grep -q "ARCHITECTURE.md\|FEATURES_CAPABILITIES.md"; then
  DOCS_UPDATED=true
fi

# Detect significant changes that should update docs
SHOULD_UPDATE_DOCS=false
DOC_TRIGGERS=""

# Check for new API routes
NEW_API_ROUTES=$(echo "$STAGED_FILES" | grep "app/api/.*/route.ts" | wc -l)
if [ "$NEW_API_ROUTES" -gt 0 ]; then
  SHOULD_UPDATE_DOCS=true
  DOC_TRIGGERS+="  - New API routes detected ($NEW_API_ROUTES files)\n"
fi

# Check for database schema changes
DB_CHANGES=$(echo "$STAGED_FILES" | grep -E "lib/database|lib/db.ts|migrations/" | wc -l)
if [ "$DB_CHANGES" -gt 0 ]; then
  SHOULD_UPDATE_DOCS=true
  DOC_TRIGGERS+="  - Database changes detected ($DB_CHANGES files)\n"
fi

# Check for AI/LLM changes
AI_CHANGES=$(echo "$STAGED_FILES" | grep -E "lib/ai/|app/api/ai/" | wc -l)
if [ "$AI_CHANGES" -gt 0 ]; then
  SHOULD_UPDATE_DOCS=true
  DOC_TRIGGERS+="  - AI/LLM changes detected ($AI_CHANGES files)\n"
fi

# Check for new schemas
SCHEMA_CHANGES=$(echo "$STAGED_FILES" | grep "lib/schemas/" | wc -l)
if [ "$SCHEMA_CHANGES" -gt 0 ]; then
  SHOULD_UPDATE_DOCS=true
  DOC_TRIGGERS+="  - Schema changes detected ($SCHEMA_CHANGES files)\n"
fi

# If significant changes detected but docs not updated, warn
if [ "$SHOULD_UPDATE_DOCS" = true ] && [ "$DOCS_UPDATED" = false ]; then
  echo ""
  echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${YELLOW}⚠️  DOCUMENTATION UPDATE RECOMMENDED${NC}"
  echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
  echo -e "${BLUE}Significant changes detected:${NC}"
  echo -e "$DOC_TRIGGERS"
  echo -e "${BLUE}Consider updating:${NC}"
  echo "  - ARCHITECTURE.md (API endpoints, database schema, data flow)"
  echo "  - FEATURES_CAPABILITIES.md (user-facing features, use cases)"
  echo ""
  echo -e "${GREEN}How to update docs:${NC}"
  echo "  1. In Claude Code, say: 'Update PlotDetect docs for [your feature]'"
  echo "  2. Or manually edit ARCHITECTURE.md and FEATURES_CAPABILITIES.md"
  echo "  3. Then run: git add ARCHITECTURE.md FEATURES_CAPABILITIES.md"
  echo ""
  echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""

  # Ask user if they want to proceed without updating docs
  # In non-interactive shells (CI, Claude Code), warn but don't block
  if [ -t 0 ]; then
    read -p "Continue commit without updating docs? (y/n) " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo -e "${RED}Commit aborted. Update docs first, then commit again.${NC}"
      exit 1
    fi
  else
    echo -e "${YELLOW}Non-interactive shell — proceeding (update docs in a follow-up commit)${NC}"
  fi

  echo -e "${GREEN}✓ Proceeding with commit (docs will need updating later)${NC}"
  echo ""
fi

# If docs were updated, remind about commit message format
if [ "$DOCS_UPDATED" = true ]; then
  # Check if this is a doc-only commit
  NON_DOC_FILES=$(echo "$STAGED_FILES" | grep -v "ARCHITECTURE.md\|FEATURES_CAPABILITIES.md" | wc -l)

  if [ "$NON_DOC_FILES" -eq 0 ]; then
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}📝 Documentation update detected${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${BLUE}Recommended commit message format:${NC}"
    echo "  docs: update architecture for [feature description]"
    echo ""
    echo "Example:"
    echo "  docs: update architecture for granny flat synthesis"
    echo "  docs: update architecture for compliance verification endpoint"
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
  fi
fi

# Allow commit to proceed
exit 0
