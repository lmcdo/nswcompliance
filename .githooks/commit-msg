#!/bin/sh
#
# QA Railguards enforcement hook
# Single hard gate: commit message must contain a QA tier line.
#
# Expected format:
#   QA: Critical — [details]
#   QA: Standard — [details]
#   QA: Minor — [details]
#
# Exempt: merge commits, revert commits, CI commits
#
# The qa_gate.py script is a SEPARATE tool that Claude runs before
# committing. Its output appears in the conversation for human review.
# The hook does NOT call qa_gate.py because:
#   - Humans shouldn't need python + JSON to commit
#   - Hook must work on any machine (pure shell, no deps)
#   - Missing script output in conversation = visibly skipped QA

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Skip merge commits
if echo "$MSG" | head -1 | grep -qiE "^Merge "; then
  exit 0
fi

# Skip revert commits
if echo "$MSG" | head -1 | grep -qiE "^Revert "; then
  exit 0
fi

# Skip CI / automated commits
if echo "$MSG" | grep -qiE "^\[skip ci\]|^\[ci skip\]|^chore\(deps\)"; then
  exit 0
fi

# Check for QA line
if ! echo "$MSG" | grep -qE "^QA: (Critical|Standard|Minor) "; then
  echo ""
  echo "=========================================="
  echo "  COMMIT REJECTED — QA line missing"
  echo "=========================================="
  echo ""
  echo "Every commit requires a QA tier classification."
  echo "Add one of these lines to your commit message:"
  echo ""
  echo "  QA: Critical — [sections] — [findings]"
  echo "  QA: Standard — [sections] — [findings]"
  echo "  QA: Minor — [sections] — [findings]"
  echo ""
  exit 1
fi

exit 0
