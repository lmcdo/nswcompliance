#!/bin/sh
# pre-push hook — runs automated checks before allowing push.
# To bypass in an emergency: git push --no-verify
#
# Checks:
#   0. Push-to-main guard
#   0b. Planted-defect guard (a falsifiability proof left a mutation on disk)
#   1. Python unit tests (1794+ tests)
#   1b. Mutation test count baselines (ratchet — counts never drop)
#   2. Frontend Jest tests (615+ tests)
#   3. QA report validation (structure, AST grounding, depth)
#   4. Liability language scan on changed user-facing files

# ── 0. Push-to-main guard — force PR workflow ───────────────────────────────
while read local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -qE "refs/heads/(main|master)$"; then
    echo ""
    echo "=========================================="
    echo "  PUSH REJECTED — never push to main"
    echo "=========================================="
    echo "  Open a PR: gh pr create"
    exit 1
  fi
done

set -e

# ── 0b. Planted-defect guard ────────────────────────────────────────────────
# A falsifiability proof plants a defect, confirms the check goes red, and
# restores. On 2026-08-07 one of those scripts died before its restore line and
# left the planted defect in the working tree; it was caught by a later grep and
# could have shipped. scripts/falsifiability.py writes a sidecar before every
# plant and deletes it only after a verified restore, so a surviving sidecar is
# proof that a run died mid-plant.
#
# This one BLOCKS rather than warning, and unlike a lint it cannot false-positive:
# the sidecar exists only if a plant was started and not verifiably undone.
#
# The sidecar search runs in SHELL, not in Python, and does not depend on the
# helper existing. Gating it on `-f scripts/falsifiability.py` would fail open
# in exactly the situation that matters most: a proof leaves a mutation behind
# and the helper is then deleted, renamed or missing from the checkout.
SIDECARS=$(find . -name '*.falsifiability-bak' -not -path './node_modules/*' \
                  -not -path './.git/*' 2>/dev/null)
if [ -n "$SIDECARS" ]; then
  echo ""
  echo "=========================================="
  echo "  PUSH REJECTED — a planted defect is still on disk"
  echo "=========================================="
  echo "$SIDECARS"
  echo ""
  echo "  A falsifiability proof died before restoring its plant."
  echo "  Restore it: python scripts/falsifiability.py --recover"
  exit 1
fi

# ── Advisory: warn if changed files overlap an open PR (non-blocking) ────────
# Catches accidental duplication of in-flight work that code guards can't see.
if [ -f scripts/pr_overlap_guard.py ]; then
  python scripts/pr_overlap_guard.py 2>/dev/null || true
fi

# ── 1. Python unit tests ─────────────────────────────────────────────────────

echo "=== [1/4] Running Python unit tests ==="
# Scoped to pushes that actually touch Python. Measured 2026-08-12: the full
# suite is ~3-5 min locally on Windows and 63s in CI on the self-hosted Linux
# runners, so running it here on a docs- or frontend-only push costs minutes
# and duplicates a backstop that is both FASTER and already mandatory.
#
# This is not a weakening: CI runs the full suite on every PR and on every push
# to main, and `gates` is required before merge (check_pr_gates.py). What
# changes is only WHERE the wait happens on a push that cannot have broken a
# Python test.
#
# Fail closed: if the merge-base cannot be determined, run everything.
# Not just *.py: a requirements bump, a conftest edit or a pytest.ini change
# can break collection without a single .py file in the diff, and "no Python
# changed" would then be a wrong reason to skip.
PY_BASE=$(git merge-base origin/main HEAD 2>/dev/null || true)
if [ -n "$PY_BASE" ]; then
  PY_CHANGED=$(git diff --name-only "$PY_BASE"...HEAD -- \
    '*.py' 'requirements*.txt' '*/requirements*.txt' \
    'pytest.ini' 'setup.cfg' 'pyproject.toml' 'conftest.py' '*/conftest*.py' \
    2>/dev/null)
else
  PY_CHANGED="unknown"
fi

if [ -z "$PY_CHANGED" ]; then
  echo "Skipped: no .py changed vs origin/main on this branch."
  echo "  CI still runs the full suite on the PR — this only moves the wait."
else
  # -n auto: pytest-xdist is already a dependency and was simply never used, so
  # every push ran the whole suite on one core. Measured 2026-09-24 on a 20-core
  # machine: 430s serial vs 188s parallel, with an identical result (7,015
  # passed, 2 skipped) — the suite is xdist-safe, it just was not told to be.
  # That wait is paid on EVERY push whatever the change, which makes it the
  # single largest fixed cost in the edit-verify loop.
  #
  # -x still stops at the first failure, but under xdist that means "shortly
  # after" rather than "immediately": workers already in flight finish their
  # current test, so a failing run can report one failure plus a few extra
  # passes. That is the trade — a couple of seconds of overshoot against four
  # minutes saved every time.
  python -m pytest tests/ -n auto -x -q --tb=short 2>&1
fi
echo ""

# ── 1b. Mutation test count baselines ────────────────────────────────────────

echo "=== [1b/5] Checking mutation test baselines ==="
if [ -f mutation-baselines.json ] && [ -f scripts/check_test_baselines.py ]; then
  # `set -e` is on (line 26); a bare command here would kill the hook on any
  # real failure before the message below ever prints, same class of bug as
  # [2c]'s doc-claim ratchet (see that block's comment) and [3]'s QA report.
  BASELINE_RESULT=0
  python scripts/check_test_baselines.py mutation-baselines.json 2>&1 || BASELINE_RESULT=$?
  if [ $BASELINE_RESULT -ne 0 ]; then
    echo ""
    echo "Mutation test baseline check FAILED. Push blocked."
    echo "If tests were intentionally removed, update mutation-baselines.json."
    exit 1
  fi
else
  echo "  Skipping (no mutation-baselines.json or check script)."
fi
echo ""

# ── 1c. Brief field-coverage ratchet ─────────────────────────────────────────
# A brief layer may gain fields, never silently lose them (S3 enforcement).

echo "=== [1c/5] Brief field-coverage ratchet ==="
if [ -f scripts/brief_field_coverage_ratchet.py ]; then
  # Same set -e trap as [1b] above.
  RATCHET_RESULT=0
  python scripts/brief_field_coverage_ratchet.py 2>&1 || RATCHET_RESULT=$?
  if [ $RATCHET_RESULT -ne 0 ]; then
    echo ""
    echo "Brief field-coverage ratchet FAILED. Push blocked."
    echo "Intentional field addition: python scripts/brief_field_coverage_ratchet.py --regen"
    echo "Intentional removal: edit scripts/brief_field_coverage_baseline.json and explain in the PR."
    exit 1
  fi
else
  echo "  Skipping (no ratchet script)."
fi
echo ""

# ── 1d. Schema contract — code's SQL identifiers vs the live catalog ─────────
# Catches a table/column that was renamed or dropped out from under a query.
# Nothing else does: SQL identifiers sit inside template literals and Python
# strings, invisible to tsc and to every test that avoids a real database.
#
# Needs DATABASE_URL. When it is absent (bare worktree, no .env) the check is
# SKIPPED and says so — it is not reported as a pass, and CI (.github/workflows/
# gates.yml) runs it unconditionally on every PR, so nothing relies on this
# local run having happened.

echo "=== [1d/5] Schema contract (SQL identifiers vs live catalog) ==="
if [ -f scripts/validate_schema_contract.py ]; then
  # `|| SCHEMA_RESULT=$?` keeps this exempt from the `set -e` above; a bare
  # invocation would abort the hook on exit 2 and block the push for the one
  # case that is meant to be a skip.
  SCHEMA_RESULT=0
  python scripts/validate_schema_contract.py --quiet 2>&1 || SCHEMA_RESULT=$?
  if [ $SCHEMA_RESULT -eq 2 ]; then
    echo "⏭  Skipped: no DATABASE_URL reachable — NOT verified locally. CI enforces this."
  elif [ $SCHEMA_RESULT -ne 0 ]; then
    echo ""
    echo "Schema contract FAILED. Push blocked."
    echo "A NEW query references a table/column the database does not have,"
    echo "or a baseline entry is now fixed and must be deleted."
    echo "Detail: python scripts/validate_schema_contract.py"
    exit 1
  fi
else
  echo "  Skipping (no schema contract script)."
fi

echo "=== [1e/5] Controls provenance (every numeric control accounted for) ==="
if [ -f scripts/validate_controls_provenance.py ]; then
  # Same `|| RESULT=$?` shape as [1d]: exit 2 means no DATABASE_URL, which is a
  # skip, and a bare invocation would abort the hook under `set -e`.
  PROV_RESULT=0
  python scripts/validate_controls_provenance.py --quiet 2>&1 || PROV_RESULT=$?
  if [ $PROV_RESULT -eq 2 ]; then
    echo "⏭  Skipped: no DATABASE_URL reachable — NOT verified locally. CI enforces this."
  elif [ $PROV_RESULT -ne 0 ]; then
    echo ""
    echo "Controls provenance FAILED. Push blocked."
    echo "Scope note: this covers all 1,069 rows regardless of is_current — an"
    echo "unattributable control is a defect whether or not it is currently served."
    echo "A row in dcp_setback_controls has no provenance of any kind: no committed"
    echo "script regenerates it and it carries no source_text + section_ref to"
    echo "re-check it against. An unattributable control is indistinguishable from"
    echo "a guess, which is the whole differentiator this table represents."
    echo "Detail: python scripts/validate_controls_provenance.py"
    exit 1
  fi
else
  echo "  Skipping (no controls provenance script)."
fi

echo "=== [1f/5] Control values vs their own source_text ==="
if [ -f scripts/validate_control_source_values.py ]; then
  # Same `|| RESULT=$?` shape as [1d]/[1e]: 2 is "no DATABASE_URL" (a skip), 1 is
  # a real finding. Unlike provenance, this one covers all 1,069 rows rather than
  # the 42 the corpus can reach, because it compares each number to the quote
  # stored beside it instead of to the provisions corpus.
  SRCVAL_RESULT=0
  python scripts/validate_control_source_values.py 2>&1 || SRCVAL_RESULT=$?
  if [ $SRCVAL_RESULT -eq 2 ]; then
    echo "⏭  Skipped: no DATABASE_URL reachable — NOT verified locally. CI enforces this."
  elif [ $SRCVAL_RESULT -ne 0 ]; then
    echo ""
    echo "Control source-value check FAILED. Push blocked."
    echo "Either a control's stored number is not derivable from its own quoted"
    echo "source_text by any named rule and is not in the accepted baseline, or a"
    echo "SERVED control carries a value its own note admits was assumed."
    echo "Either correct the value, correct the quote, or add the rule that names"
    echo "the derivation. Widening the baseline to make this pass defeats it."
    echo "Detail: python scripts/validate_control_source_values.py --show-evidence"
    exit 1
  fi
else
  echo "  Skipping (no control source-value script)."
fi
echo ""

# ── 2. Frontend Jest tests ──────────────────────────────────────────────────

echo "=== [2/4] Running frontend Jest tests ==="
if [ ! -d frontend-nextjs/node_modules ]; then
  # A bare git worktree has no node_modules, so jest cannot run at all and would
  # false-fail the push. Skip it here; jest still gates on any push from a full
  # checkout (deps present). Run from a full checkout to gate frontend tests.
  echo "⏭  Skipped: frontend-nextjs/node_modules absent (bare worktree) — jest cannot run without deps."
elif [ -f frontend-nextjs/jest.config.js ]; then
  # --no-cache removed 2026-08-12. MEASURED on this repo: 98s with it, 36s
  # without — 62 seconds burned on every single push. CI runs `jest --ci
  # --silent` WITH the cache and has never been wrong for it, because jest keys
  # its cache on file content and babel config, so a stale hit is not a failure
  # mode this repo has. If a cache ever is suspected, bust it explicitly:
  #   cd frontend-nextjs && npx jest --clearCache
  # `|| JEST_RESULT=$?`: same set -e trap as [1b]/[1c] above -- a bare failure
  # here would kill the hook before the "Push blocked" message ever printed.
  JEST_RESULT=0
  (cd frontend-nextjs && npx jest --bail --silent 2>&1) || JEST_RESULT=$?
  if [ $JEST_RESULT -ne 0 ]; then
    echo ""
    echo "Frontend Jest tests FAILED. Push blocked."
    echo "Run: cd frontend-nextjs && npx jest --verbose"
    exit 1
  fi
else
  echo "WARNING: No jest.config.js found. Skipping frontend tests."
fi
echo ""

# ── 2b. Production build (only when frontend files changed) ─────────────────
#
# Added 2026-08-26 after a full DAY of failed Vercel deploys. Two fatal defects
# reached main — an unescaped apostrophe in a metadata string, and a duplicate
# interface key — and BOTH passed jest, the QA gate and cross-review, because
# neither file ever executes: one is parsed by SWC at build time, the other is
# a type erased before runtime. Only a compile can see them.
#
# Gated on the diff. A production build costs ~2 minutes and most pushes here
# touch no frontend file at all; charging every push for a check that cannot
# apply is how a hook gets bypassed rather than fixed.

echo "=== [2b/4] Production build ==="
# MERGE_BASE is computed later in this file, for the cross-review step. Using
# it here would silently expand to empty, the diff would error, CHANGED_FE
# would be 0, and this gate would skip on EVERY push while appearing to run.
# That is the same shape as the defect it exists to catch, so it is computed
# locally instead.
BUILD_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "origin/main")
CHANGED_FE=$(git diff --name-only "$BUILD_BASE" HEAD 2>/dev/null | grep -c '^frontend-nextjs/' || true)
if [ ! -d frontend-nextjs/node_modules ]; then
  echo "⏭  Skipped: frontend-nextjs/node_modules absent (bare worktree)."
elif [ "${CHANGED_FE:-0}" -eq 0 ]; then
  echo "⏭  Skipped: no frontend-nextjs/ files in this push."
else
  echo "   $CHANGED_FE frontend file(s) changed — building."
  # `set -e` is on (line 26), so a bare failing command kills the hook before
  # the next line reads its status — the block's own message would never print.
  # `|| VAR=$?` makes it part of a compound command, which set -e does not trip.
  BUILD_RESULT=0
  (cd frontend-nextjs && npm run build 2>&1 | tail -25) || BUILD_RESULT=$?
  if [ "$BUILD_RESULT" -ne 0 ]; then
    echo ""
    echo "Production build FAILED. Push blocked."
    echo "A failed build does NOT take the site down — Vercel keeps serving the"
    echo "last good deploy — so nothing would alert you. It is invisible until"
    echo "someone opens the Deployments list."
    echo "Run: cd frontend-nextjs && npm run build"
    exit 1
  fi
fi
echo ""

# ── 2c. Doc-claim ratchet ───────────────────────────────────────────────────
#
# scripts/doc_claims.py has existed with a baseline, --compare and --strict for
# weeks, and its own docstring said: "Reports; blocks nothing. --strict exists
# but is wired into no hook and no CI." So it ran, printed, and stopped nothing —
# and 13 new violations accumulated in the fortnight after the last baseline.
#
# Exit contract: 1 = NEW claims that do not hold, 2 = the scan had gaps it could
# not resolve, 0 = clean. Only 1 blocks. Exit 2 is deliberate in that tool ("a
# scan that could not run is not a clean scan") but 43 unmappable test imports
# make it permanent, and a gate that always fires is a gate that gets removed.

echo "=== [2c/4] Doc-claim ratchet ==="
# Same `set -e` trap as the build block above, and worse here: this tool exits
# 2 on a CLEAN run that had scan gaps, so under set -e a perfectly good result
# killed the hook silently. The push failed with no message at all — the header
# printed and nothing followed.
DOC_CLAIM_RESULT=0
python scripts/doc_claims.py --compare --strict > /tmp/doc_claims_push.log 2>&1   || DOC_CLAIM_RESULT=$?
if [ "$DOC_CLAIM_RESULT" -eq 1 ]; then
  grep -E "^  - \[" /tmp/doc_claims_push.log | head -20
  echo ""
  echo "NEW doc claims that do not hold. Push blocked."
  echo "A doc naming a file that does not exist is a claim about the codebase"
  echo "that nothing else checks."
  echo "Run: python scripts/doc_claims.py --compare --strict"
  echo "If the claim is right and the baseline is stale:"
  echo "  python scripts/doc_claims.py --init"
  exit 1
elif [ "$DOC_CLAIM_RESULT" -eq 2 ]; then
  echo "   0 new claims. (scan gaps present — see --compare output)"
else
  echo "   0 new claims."
fi
echo ""

# ── 3. QA report validation ──────────────────────────────────────────────────

echo "=== [3/4] Validating QA report ==="
# The report is per-branch (.qa/reports/<slug>.json). Resolve it rather than
# hardcoding a path, so this hook and CI can never disagree about which file
# they are checking — a disagreement would present as "the gate passed".
# `set -e` is on (line 26) and this script exits 1 (printing nothing) when no
# report exists for this branch yet -- the normal case for a brand-new branch.
# Without `|| QA_REPORT=""` that nonzero status kills the WHOLE hook right here,
# before the `if` below ever runs its "no report, skipping" warning: the push
# just fails with git's own generic "failed to push some refs", no explanation
# printed at all. Same set -e trap as the build block above (line 269-271).
QA_REPORT=$(python scripts/qa_report_path.py --relative 2>/dev/null) || QA_REPORT=""
if [ -n "$QA_REPORT" ] && [ -f "$QA_REPORT" ]; then
  # Auto-detect changed files vs merge-base (works correctly in worktrees where origin/main may have diverged)
  MERGE_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "origin/main")
  DIFF_FILES=$(git diff --name-only "$MERGE_BASE"...HEAD -- '*.py' '*.ts' '*.tsx' '*.jsx' 2>/dev/null)
  # --require-tracked: at push time the report must already be in git. A report
  # that exists only on this disk means the branch arrives at CI without one,
  # and CI treats an absent report as ::warning:: + exit 0 — so the gate would
  # pass here and enforce nothing there. Added 2026-08-12 after exactly that
  # happened: a branch named test/... produced a slug matching test_*.json in
  # .gitignore, `git add` silently did nothing, and this gate printed PASSED.
  QA_ARGS="$QA_REPORT --require-tracked"
  if [ -n "$DIFF_FILES" ]; then
    QA_ARGS="$QA_ARGS --diff-files $DIFF_FILES"
  fi
  # `|| QA_RESULT=$?`: same set -e trap fixed just above for QA_REPORT itself --
  # a bare failure here would kill the hook before the "Push blocked" message
  # (and the fix-it hint) ever printed.
  QA_RESULT=0
  python scripts/qa_gate.py $QA_ARGS 2>&1 || QA_RESULT=$?
  if [ $QA_RESULT -ne 0 ]; then
    echo ""
    echo "QA report validation FAILED. Push blocked."
    echo "Fix $QA_REPORT and re-run: python scripts/qa_gate.py $QA_REPORT"
    exit 1
  fi
else
  TARGET=$(python scripts/qa_report_path.py --target --relative 2>/dev/null)
  echo "WARNING: No QA report for this branch. Skipping QA validation."
  echo "  Expected at: ${TARGET:-.qa/reports/<branch-slug>.json}"
  echo "  Create one from scripts/qa_report_template.json before non-trivial changes."
fi
echo ""

# ── 3. Liability language check ──────────────────────────────────────────────

echo "=== [4/4] Scanning for liability language ==="

# Scan only NEW lines in user-facing files (not existing reviewed code)
LANG_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "origin/main")
# `|| LANG_RESULT=$?`: same set -e trap as the QA gate above -- a bare failure
# here would kill the hook before the "Push blocked" message ever printed.
LANG_RESULT=0
python scripts/liability_language_check.py --diff-base "$LANG_BASE" 2>&1 || LANG_RESULT=$?
if [ $LANG_RESULT -ne 0 ]; then
  echo ""
  echo "Liability language check FAILED. Push blocked."
  echo "Review flagged terms above. See docs/qa/language-audit-2026-05-18.md"
  exit 1
fi

# ── 5. Mutation testing (opt-in) ─────────────────────────────────────────────
# Set MUTMUT=1 to enable. Runs mutmut on changed services/*.py files only.
# Reports mutation score but does NOT block push (informational).
# Requires: WSL with /tmp/mutmut_venv (see scripts/run_mutation_tests.sh)

if [ "${MUTMUT:-0}" = "1" ]; then
  echo ""
  echo "=== [5/5] Mutation testing (changed service files) ==="
  MUTMUT_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "origin/main")
  CHANGED_SERVICES=$(git diff --name-only "$MUTMUT_BASE"...HEAD -- 'services/*.py' 2>/dev/null | grep -v '__pycache__')

  if [ -z "$CHANGED_SERVICES" ]; then
    echo "No changed services/*.py files — skipping mutation testing."
  else
    # Map service files to their test files
    for svc in $CHANGED_SERVICES; do
      base=$(basename "$svc" .py)
      test_file="tests/test_${base}.py"
      # Some test files use different naming
      if [ ! -f "$test_file" ]; then
        test_file="tests/test_${base}_logic.py"
      fi
      if [ ! -f "$test_file" ]; then
        echo "  No test file found for $svc — skipping"
        continue
      fi

      echo "  Mutating: $svc (tests: $test_file)"

      # Run via WSL if available, otherwise skip
      if command -v wsl >/dev/null 2>&1 && wsl test -x /tmp/mutmut_venv/bin/mutmut 2>/dev/null; then
        WSL_PATH=$(wsl wslpath -u "$(pwd)" 2>/dev/null || echo "/mnt/$(pwd | sed 's|\\|/|g; s|^\([A-Z]\):|/\L\1|')")
        wsl bash -c "
          cd '$WSL_PATH' &&
          rm -f .mutmut-cache &&
          /tmp/mutmut_venv/bin/mutmut run \
            --paths-to-mutate='$svc' \
            --tests-dir=tests/ \
            --runner='/tmp/mutmut_venv/bin/python -m pytest $test_file -x -q --no-header --tb=no' \
            --no-progress 2>&1 | tail -1 &&
          /tmp/mutmut_venv/bin/python3 -c \"
import sqlite3
conn = sqlite3.connect('.mutmut-cache')
c = conn.cursor()
c.execute('SELECT status, count(*) FROM Mutant GROUP BY status')
r = dict(c.fetchall())
t = sum(r.values())
k = r.get('ok_killed', 0)
s = r.get('bad_survived', 0)
pct = k/t*100 if t else 0
print(f'  Mutation score: {k}/{t} killed ({pct:.0f}%)')
conn.close()
\"
        " 2>&1
      else
        echo "  WSL/mutmut not available — skipping. See scripts/run_mutation_tests.sh for setup."
      fi
    done
  fi
else
  echo ""
  echo "Tip: set MUTMUT=1 to run mutation testing on changed service files."
fi

# ── 6. Duplication ratchet (jscpd) ───────────────────────────────────────────
# Coarse repo-wide copy-paste ratchet (baseline 6.77%, threshold 8% in .jscpd.json).
# Runs only when source code changed; blocks only on a real threshold breach; never
# blocks on tool/infra failure. The SHARP per-new-file guard is the prior-art injector
# (.claude/hooks/prior-art-guard.py).
echo ""
echo "=== [6] Duplication ratchet (jscpd) ==="
DUP_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "origin/main")
CHANGED_CODE=$(git diff --name-only "$DUP_BASE"...HEAD 2>/dev/null \
  | grep -E '^(services|scripts|src|frontend-nextjs/(app|components|lib))/.*\.(py|ts|tsx)$' \
  | grep -vE '(test|__tests__|\.spec\.)' || true)
if [ -z "$CHANGED_CODE" ]; then
  echo "No source code changed — skipping duplication ratchet."
elif command -v node >/dev/null 2>&1; then
  JSCPD_OUT=$(npx --yes jscpd@4 2>&1)
  JSCPD_RC=$?
  echo "$JSCPD_OUT" | grep -iE "duplicated lines|too many duplicates" | tail -2
  if [ $JSCPD_RC -ne 0 ] && echo "$JSCPD_OUT" | grep -qi "too many duplicates"; then
    echo "Duplication exceeds the 8% ratchet (baseline 6.77%, 2026-06-19)."
    echo "Reuse/extend existing code instead of copy-paste, or refactor the clone."
    echo "Emergency bypass: git push --no-verify"
    exit 1
  elif [ $JSCPD_RC -ne 0 ]; then
    echo "WARNING: jscpd could not run cleanly — skipping ratchet (not blocking)."
  fi
else
  echo "node not available — skipping duplication ratchet."
fi

# ── [7] GPT-5.6 Sol cross-review — BLOCKING on HIGH for served/printed output ─
# A different-model-family (OpenAI) second opinion on the pushed diff, scored
# against .claude/rules/pre-pr-review.md.
#
# Why it blocks at all: it found a real defect on both PRs it was run against
# (2026-08-01) — an unreachable-code regression that made two Marrickville DCP
# parts fall through to ALL, and a null-guard that printed a definitive "does not
# apply" from missing zone data. The full gate stack passed both times. An
# advisory line that scrolls past the end of a push is not a control.
#
# Why it blocks NARROWLY: blocking on everything would train people to bypass it,
# which is worse than not having it. So: HIGH severity AND the diff touches output
# a customer reads. Everything else stays advisory.
#
# ── What this scoping is NOT justified by, any more ──────────────────────────
# It used to cite a base rate of invalid findings. That prior ("~1 in 3 wrong")
# was WITHDRAWN on 2026-08-06 (meta-session-prompt-template-2026-08.md) and the
# code acting on it kept quoting it for ten days — including in the message
# printed to the operator at the moment of the decision, which is the worst
# possible place for a retired number. What was actually observed after it:
#   - 08-06, lane 1: 16 rounds, MOST findings real — several of them defects the
#     session introduced while fixing earlier ones.
#   - 08-16, fix/tex-repair-semantic-safety: 3 rounds, 7 findings, 7 real.
#   - The same reviewer had ALREADY flagged repair_tex_residue.py::correctness on
#     an earlier push, with the exact failure scenario. It was advisory there, so
#     it printed and passed, and the defect went on to damage 38 production rows.
# So the narrow scope is a deliberate trade against bypass behaviour, NOT a claim
# that the findings are usually wrong. Treat a finding as right until the code
# says otherwise.
#
# The honest position is that the rate is UNMEASURED: 114 findings were recorded
# across 40 branches by 2026-08-16 and not one carried a verdict, because the
# record stored only that a finding had been seen. It now stores the verdict, so
# this comment can eventually be replaced by a number with a denominator:
#   python scripts/cross_review.py --adjudicated <record> --verdict-report
# ── The review base is INCREMENTAL, and this is load-bearing ────────────────
# It used to be the merge-base with main, so every push re-read the ENTIRE
# branch. Three things followed, and all three were observed on fix/flood-finish
# on 2026-08-10 across four consecutive blocked pushes:
#
#   1. The same 2,500-line diff was re-reviewed each time. A model reading that
#      much does not return the same subset twice, so each run surfaced
#      different findings from an unchanged pool — including files last touched
#      days earlier that earlier runs had said nothing about.
#   2. Fixing everything found in run N did not reduce what run N+1 could find,
#      because run N+1 read the same diff afresh — and each fix made it bigger.
#   3. Scope was decided on the cumulative diff too, so ONE api/ file touched in
#      the branch's first commit made every later push a blocking review, even
#      pushes that changed only Python and docs.
#
# A non-deterministic sampler is a reasonable reviewer and a bad gate. Reading
# only the new commits gives it a fixed point: clear the findings and the next
# push has nothing to re-sample.
# Base selection lives in scripts/sol_review_base.sh so it can be tested
# against real git histories (tests/test_sol_review_base.py) instead of only
# ever running inside a hook, where a wrong answer is invisible.
SOL_BASE=$(bash scripts/sol_review_base.sh "$DUP_BASE" 2>/dev/null || echo "$DUP_BASE")
SOL_CHANGED=$(git diff --name-only "$SOL_BASE"...HEAD 2>/dev/null   | grep -E '^(services|scripts|src|frontend-nextjs/(app|components|lib))/.*\.(py|ts|tsx)$'   | grep -vE '(test|__tests__|\.spec\.)' || true)

SOL_SCOPED_PATHS='^(frontend-nextjs/(app/api|components/pdf|lib/pdf)/|scripts/generate_conveyancing_report\.py|scripts/conveyancing_db\.py|services/conveyancing\.py)'
SOL_TOUCHES_OUTPUT=$(echo "$SOL_CHANGED" | grep -E "$SOL_SCOPED_PATHS" || true)

# ── Per-branch memory of what has already been adjudicated ──────────────────
# Kept under .git/, NOT committed, so it dies with the branch. A finding that
# was raised once and dealt with is reported on later runs but does not gate.
# Deliberately not a committed baseline like the quarantine ratchet: that one
# describes durable code state, this one describes one branch's review cycle,
# and a permanent record here would be a standing amnesty.
# The readable part is for humans; the hash is what makes it unique. Slashes
# were simply replaced with dashes, so feat/x and feat-x shared one state file
# and one branch's adjudications would have exempted the other's findings —
# amnesty leaking across branches, which is precisely what this record must not
# do. The hash is of the exact ref, so no two branch names can collide.
SOL_REF=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)
SOL_HASH=$(printf '%s' "$SOL_REF" | sha1sum 2>/dev/null | cut -c1-10)
SOL_BRANCH="$(printf '%s' "$SOL_REF" | tr '/' '-')-${SOL_HASH:-nohash}"
SOL_STATE_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/sol-review"
SOL_ADJUDICATED="$SOL_STATE_DIR/$SOL_BRANCH.json"
SOL_ROUNDS="$SOL_STATE_DIR/$SOL_BRANCH.rounds"
mkdir -p "$SOL_STATE_DIR" 2>/dev/null || true

if [ "${SOL_REVIEW:-1}" = "1" ] && [ -n "$SOL_CHANGED" ] && [ -f scripts/cross_review.py ]; then
  echo ""
  if [ -n "$SOL_TOUCHES_OUTPUT" ]; then
    echo "=== [7] Sol cross-review (BLOCKING on HIGH — diff touches served/printed output) ==="
    echo "    reviewing $SOL_BASE..HEAD (new commits only, not the whole branch)"
    SOL_RC=0
    python scripts/cross_review.py --base "$SOL_BASE" --max-diff-kb 512 --fail-on high       --adjudicated "$SOL_ADJUDICATED" --record-adjudicated || SOL_RC=$?
    if [ "$SOL_RC" -ne 0 ]; then
      SOL_ROUND_N=$(( $(cat "$SOL_ROUNDS" 2>/dev/null || echo 0) + 1 ))
      echo "$SOL_ROUND_N" > "$SOL_ROUNDS" 2>/dev/null || true
      # A HIGH finding can still be wrong. The escape is deliberate and costs a
      # sentence: verify it, and if it is a false positive say why in one line.
      if [ -n "$SOL_OVERRIDE" ] && [ ${#SOL_OVERRIDE} -ge 15 ]; then
        echo ""
        echo "⚠  Sol HIGH finding overridden: $SOL_OVERRIDE"
        # THE OVERRIDE IS THE VERDICT. This is the only moment a human actually
        # judges a finding, and until 2026-08-16 the judgement was echoed to a
        # terminal and discarded — which is why §7 finding 6's promotion path
        # (block once an observed false-positive rate justifies it) had an input
        # of zero after 114 recorded findings. `|| true`: failing to file
        # evidence must never fail a push that was already allowed.
        python scripts/cross_review.py --adjudicated "$SOL_ADJUDICATED" \
          --record-verdict "$SOL_OVERRIDE" || true
        echo "   (repeat it in the PR body — this record is local and per-branch)"
      elif [ "$SOL_ROUND_N" -ge 2 ]; then
        # ── The round cap ───────────────────────────────────────────────────
        # LOWERED 3 -> 2 on 2026-08-17, by the operator, after a session spent
        # an hour on fix/solar-dc-vs-delivered grinding through five rounds of
        # findings. Two blocked pushes on one branch is no longer a review
        # finding defects, it is a loop. Keep blocking, but stop implying that
        # another fix round will clear it: make the human decision explicit
        # instead of something that emerges after an hour of grinding.
        #
        # ⚠ THE CAP WAS NOT THE BINDING CONSTRAINT IN THAT SESSION, and lowering
        # it will not on its own prevent a repeat. Measured afterwards: Sol
        # blocked ONCE (the .rounds file read 1), while 5 of the branch's 9
        # commits were `chore(qa): restamp`. The multiplier was the QA report
        # stamp — every fix commit staled it, the gate then refused the push,
        # and clearing that took another commit which staled it again. Look
        # there before assuming this counter is what ran away.
        echo ""
        echo "Sol has now blocked this branch $SOL_ROUND_N times. STOP FIXING."
        echo ""
        echo "Past two rounds the findings are usually about the fixes themselves,"
        echo "and each fix adds code for the next round to read. Decide, do not"
        echo "iterate:"
        echo ""
        echo "  - the finding is REAL and worth it  -> fix it, and expect another round"
        echo "  - it is real but not worth blocking -> SOL_OVERRIDE=\"real: ...\" git push"
        echo "  - it is wrong                       -> SOL_OVERRIDE=\"wrong: ...\" git push"
        echo ""
        echo "  The real:/wrong: prefix is what makes the override countable. Without"
        echo "  one the push still goes through and the reason is still kept, but the"
        echo "  finding stays UNREVIEWED and proves nothing either way."
        echo ""
        echo "  Reset the counter: rm \"$SOL_ROUNDS\""
        exit 1
      else
        echo ""
        echo "Sol reported a HIGH finding on output a customer reads. Push blocked."
        echo "(round $SOL_ROUND_N on this branch; at 2 the guidance changes)"
        echo ""
        echo "  1. Verify the finding against the code. Treat it as RIGHT until the"
        echo "     code says otherwise — the last measured rounds were 7 findings /"
        echo "     7 real (08-16) and 16 rounds mostly real (08-06). Do not carry a"
        echo "     base rate in from memory; ask --verdict-report for the measured one."
        echo "  2. If it is REAL   — fix it."
        echo "  3. If it is WRONG  — re-push with a PREFIXED one-line reason:"
        echo "       SOL_OVERRIDE=\"wrong: assumes X, but Y guards it at line N\" git push"
        echo "     'real:' works too, for a correct finding you are not fixing here."
        echo "     The prefix is what records a verdict; without it the reason is kept"
        echo "     but the finding stays UNREVIEWED and no rate can ever be measured."
        echo "     If SEVERAL findings blocked, name the one you are judging —"
        echo "     one reason cannot judge two, so an unnamed verdict is not scored:"
        echo "       SOL_OVERRIDE=\"services/x.py::null-guard=wrong: ...\" git push"
        echo ""
        echo "  Emergency bypass (leaves no reason on record): git push --no-verify"
        exit 1
      fi
    fi
  else
    echo "=== [7] Sol cross-review (advisory — diff does not touch served/printed output) ==="
    # `|| true`: set -e is active, and a review outage must never stop a push.
    python scripts/cross_review.py --base "$SOL_BASE" --max-diff-kb 512       --adjudicated "$SOL_ADJUDICATED" --record-adjudicated || true
    echo "(advisory only — verify each finding against the code; never a merge gate)"
  fi
fi

# A push that gets through resets the round counter: the next block is round 1,
# not a continuation of a cycle that already ended.
rm -f "$SOL_ROUNDS" 2>/dev/null || true

echo ""
echo "All pre-push checks passed."
