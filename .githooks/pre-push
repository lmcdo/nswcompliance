#!/bin/sh
# pre-push hook — runs Python unit tests before allowing push.
# To bypass in an emergency: git push --no-verify

echo "Running Python unit tests..."
python -m pytest tests/ -x -q --tb=short 2>&1
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "Python tests FAILED. Push blocked."
  echo "Fix tests or bypass with: git push --no-verify"
  exit 1
fi

echo "All tests passed."
