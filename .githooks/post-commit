#!/bin/sh
# post-commit hook — stamps the current commit hash into this branch's QA report
#
# This does NOT amend the commit (that creates circular hash problems).
# Instead it updates the working copy of the report so that the NEXT commit
# or the pre-push QA gate check will see a valid hash.
#
# qa_gate.py requires the hash to name one of THIS BRANCH'S OWN commits — an
# ancestor of HEAD that is not already on origin/main. The hash stamped here is
# HEAD, so it satisfies that both now and after further commits land on top.
#
# The path is resolved by scripts/qa_report_path.py rather than hardcoded: the
# report is per-branch (.qa/reports/<slug>.json) precisely so two branches
# never write the same file, and five callers must agree on where it is.

QA_REPORT=$(python scripts/qa_report_path.py --relative 2>/dev/null)

# No report for this branch, or python unavailable — nothing to stamp.
[ -n "$QA_REPORT" ] || exit 0
[ -f "$QA_REPORT" ] || exit 0

# Skip during rebase/merge
[ -d "$(git rev-parse --git-dir)/rebase-merge" ] && exit 0
[ -d "$(git rev-parse --git-dir)/rebase-apply" ] && exit 0
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0

# Get the current commit short hash
HASH=$(git rev-parse --short HEAD)

# Update the hash in the report (working copy only, no amend)
if grep -q '"commit_hash"' "$QA_REPORT" 2>/dev/null; then
    CURRENT_HASH=$(grep '"commit_hash"' "$QA_REPORT" | sed 's/.*: *"\([^"]*\)".*/\1/')
    if [ "$CURRENT_HASH" != "$HASH" ]; then
        sed -i "s/\"commit_hash\": *\"[^\"]*\"/\"commit_hash\": \"$HASH\"/" "$QA_REPORT"
    fi
fi
