#!/bin/sh

# pre-commit hook — 6 checks before every commit.
# To bypass in an emergency: git commit --no-verify

# ── 1. Branch guard — never commit to main ───────────────────────────────────
BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo ""
  echo "=========================================="
  echo "  COMMIT REJECTED — never commit to main"
  echo "=========================================="
  echo "  Run: git checkout -b feat/<description>"
  exit 1
fi

# ── 2. Secrets scan — block credentials in staged files ──────────────────────
SECRETS_FOUND=0

# Block dangerous filenames
DANGEROUS_FILES=$(git diff --cached --name-only | grep -iE '\.(env|pem|key)$|credentials\.json|\.secret' || true)
if [ -n "$DANGEROUS_FILES" ]; then
  echo "COMMIT REJECTED — sensitive file staged:"
  echo "$DANGEROUS_FILES"
  SECRETS_FOUND=1
fi

# Scan staged content for key patterns (exclude hook files which contain these patterns as search terms)
STAGED_SECRETS=$(git diff --cached -U0 -- ':!.githooks/*' | grep -iE '(SUPABASE_SERVICE_ROLE|sk_live_|sk_test_|PRIVATE_KEY|-----BEGIN (RSA |EC )?PRIVATE KEY)' || true)
if [ -n "$STAGED_SECRETS" ]; then
  echo "COMMIT REJECTED — possible secret in staged changes:"
  echo "$STAGED_SECRETS" | head -5
  SECRETS_FOUND=1
fi

# DB connection strings with an inline password (e.g. postgresql://user:pass@host).
# Scoped to ADDED lines (^+) so REMOVING a previously-committed credential is never
# blocked. This is the leak class that put a live Supabase password into ~22 files.
ADDED_DB_URLS=$(git diff --cached -U0 -- ':!.githooks/*' | grep -E '^\+' | grep -iE '(postgres(ql)?|mysql|mongodb(\+srv)?|redis|amqp)://[^:@/]+:[^@/]+@' || true)
if [ -n "$ADDED_DB_URLS" ]; then
  echo "COMMIT REJECTED — database URL with inline password in staged changes:"
  echo "$ADDED_DB_URLS" | head -5
  echo "  Move it to an env var (process.env.DATABASE_URL / os.environ['DATABASE_URL'])."
  SECRETS_FOUND=1
fi

if [ "$SECRETS_FOUND" -ne 0 ]; then
  echo "  If intentional, use: git commit --no-verify"
  exit 1
fi

# ── 3. Large file gate — block files > 2MB ───────────────────────────────────
MAX_SIZE=2097152  # 2MB
LARGE_FOUND=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$f" ]; then
    SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt "$MAX_SIZE" ]; then
      echo "COMMIT REJECTED — $f is $(( SIZE / 1048576 ))MB (limit 2MB)"
      LARGE_FOUND=1
    fi
  fi
done
if [ "$LARGE_FOUND" -ne 0 ]; then
  echo "  Use .gitignore or git-lfs for large files."
  exit 1
fi

# ── 4. TSC error count gate ──────────────────────────────────────────────────
TSC_BASELINE=677

cd frontend-nextjs || exit 0

echo "🔍 Running type check (error count gate, baseline $TSC_BASELINE)..."
COUNT=$(npx tsc --noEmit --skipLibCheck 2>&1 | grep -c "error TS" || true)

if [ "$COUNT" -gt "$TSC_BASELINE" ]; then
  echo ""
  echo "❌ Type check FAILED: $COUNT errors (baseline $TSC_BASELINE, +$((COUNT - TSC_BASELINE)) new)"
  echo "   Fix new TypeScript errors before committing."
  echo "   Run: cd frontend-nextjs && npx tsc --noEmit --skipLibCheck 2>&1 | grep 'error TS'"
  exit 1
fi

echo "✅ Type check passed: $COUNT errors (baseline $TSC_BASELINE)"

# ── 5. Documentation reminder hook ───────────────────────────────────────────
cd ..
if [ -f "scripts/git-hooks/pre-commit" ]; then
  echo ""
  bash scripts/git-hooks/pre-commit || exit 1
fi

# ── 6. Bracket access lint ───────────────────────────────────────────────────
echo ""
echo "🔍 Running bracket access lint on staged services/ changes..."
python scripts/lint_bracket_access.py
BRACKET_EXIT=$?
if [ "$BRACKET_EXIT" -ne 0 ]; then
  echo ""
  echo "❌ Bracket access lint FAILED — new unsafe dict access in staged changes."
  echo "   Fix with .get() or suppress with  # noqa: bracket-access"
  exit 1
fi
echo "✅ Bracket access lint passed"

echo "✅ Pre-commit checks complete"
