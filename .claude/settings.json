{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre-edit-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post-edit-quality.py"
          },
          {
            "type": "command",
            "command": "cd frontend-nextjs && npx tsc --noEmit 2>&1 | head -30"
          }
        ]
      }
    ]
  }
}
