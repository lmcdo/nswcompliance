    </node>
    <node id="6e1fff67f2fa5d677a6f8dd85b87e1c9364d467bbd6371f6f60762dc38c6ad34">
      <data key="d0">Commercial Building</data>
      <data key="d1">entity</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
    <node id="6f826d96a2f6d93090c7c273a30fed741d95bdcf7b35422708cd09d60cb62195">
      <data key="d0">Development on 170 View Street is to respect the building heights and roof forms of the adjoining View Street properties and is to have a maximum ridge height of RL14.5.</data>
      <data key="d1">event</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
