      <data key="d1">entity</data>
      <data key="d2">327d5c5a4518394d99ba13202a679b7a367cb03a1a19a9220df4de5701488785</data>
    </node>
    <node id="e21848ef1c5351dab3287d7abd2ed57ea97ffbde1688b4ec0ae5372d054d90ba">
      <data key="d0">Subdivision must not compromise the significant features of the existing site or adjoining sites, including streetscape, landscape features, trees, fences and rocky outcrops.</data>
      <data key="d1">event</data>
      <data key="d2">327d5c5a4518394d99ba13202a679b7a367cb03a1a19a9220df4de5701488785</data>
    </node>
