      <data key="d2">38c54cebcc19462d9ccd537eeb34e6466320c2d3c35218f2730e522dee591935</data>
    </node>
    <node id="c9c00c4496967662d2d5feb396b0be634ef0b3d5c053316085cb9a64c3fd7d8b">
      <data key="d0">Ensure new development maintains the same setback and enhances the streetscape character of the locality</data>
      <data key="d1">event</data>
      <data key="d2">38c54cebcc19462d9ccd537eeb34e6466320c2d3c35218f2730e522dee591935</data>
    </node>
