      <data key="d0">Treat stormwater so that the area reaches the relevant stormwater quality targets for stormwater reuse and/or stormwater entering receiving waters.</data>
      <data key="d1">event</data>
      <data key="d2">4760be1f910017a7aac406e1d16ec2ce7f55bc0ecfe5765d6386cb32e077ebc4</data>
    </node>
    <node id="d46fa5390f22159dab98d17b39ba7868c9ca991218acbc730f681a26fa548951">
      <data key="d0">Reduce the consumption of potable water through water efficient fittings and appliances, rainwater harvesting and wastewater reuse.</data>
      <data key="d1">event</data>
      <data key="d2">4760be1f910017a7aac406e1d16ec2ce7f55bc0ecfe5765d6386cb32e077ebc4</data>
    </node>
    <node id="fa96cfe1d05b679112b304537ccaacc416d77d4ed8e1b21d2c80bb9450907a1a">
      <data key="d0">Use rainwater, treated urban stormwater or treated wastewater for non-potable uses where appropriate.</data>
      <data key="d1">event</data>
      <data key="d2">4760be1f910017a7aac406e1d16ec2ce7f55bc0ecfe5765d6386cb32e077ebc4</data>
