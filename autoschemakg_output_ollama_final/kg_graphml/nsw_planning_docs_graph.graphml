      <data key="d0">On Site Detention</data>
      <data key="d1">entity</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="46ce1d8e6dc7e561aaff78ce41ef0be00056ebcf1a01daa436f3a09bc36e0c65">
      <data key="d0">Gravity Pipe System</data>
      <data key="d1">entity</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="64faf84e4ff85b50a82befe39b17d7da32419f98e21f7981c10de39e9a035707">
      <data key="d0">The flow of stormwater from developments needs to be managed so as to negate or reduce to an acceptable frequency the possibility of flooding buildings and/or the danger to life at any location.</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="6daa4ce518fd91cafb00e891190112f64d329e21b5e229cea561bde139409259">
      <data key="d0">To protect the urban environment from the effects of otherwise uncontrolled surface stormwater flows resulting from infrequent (and lesser) storm events.</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="5e8a0168742708a88bea274a746c0326b3b4cd8b2af9051f9efc113ae6222932">
      <data key="d0">To minimise or negate disruption and/or danger to both pedestrian and vehicular traffic that may be caused by otherwise uncontrolled surface stormwater flows resulting from frequent storm events.</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="3a69900a8f076561220f8ba891aa96fe56383deb8effcd50fdcfd6a16945d823">
      <data key="d0">To protect the quality of receiving waters, adjacent and downstream land-use and the rights of adjacent and downstream landowners.</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="2603211cd80fe4a89ae5e020614537bebdac8faa2ccbe7441965e58b0c73ced1">
      <data key="d0">On Site Detention Yes (3, 6)</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="036f46e373e5845e0795f89a1043143b729c6912498fca94b414e6438daec4f8">
      <data key="d0">On Site Retention Yes (3,8)</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="d837989ee8f9a40a5f3486b24147fd41dc61a123a00207ffb44d55fee8995004">
      <data key="d0">Gravity Pipe System Required Yes (4)</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="16df88a33408e10a7bfd90b4758555a64acb4e85a67e3bd99382848629a84b66">
      <data key="d0">Pump System Permitted No (4)</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
    <node id="68aa7e671fe6bd3f2ea11c246e0e2ff3206a4ebe51668ceb8ebee2f25adae8b8">
      <data key="d0">The flow of stormwater from developments needs to be managed so as to negate or reduce to an acceptable frequency the possibility of flooding buildings and/or the danger to life at any location, through the storage of stormwater where appropriate in developments and the control of major development drainage systems.</data>
      <data key="d1">event</data>
      <data key="d2">337f42c94de20ff6f5502760a8af2637b4825945eaae1901a16864899bee2787</data>
    </node>
