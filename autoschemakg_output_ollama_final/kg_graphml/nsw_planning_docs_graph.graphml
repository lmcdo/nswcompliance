      <data key="d1">entity</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
    <node id="12ca30b66e4492c462a8521cebd0bb93748e29043a090c85076493c9ccab0d34">
      <data key="d0">The top of the southern boundary wall adjacent to No. 231 Johnston Street is to be a maximum of RL18.10 to reduce the overshadowing to the rear yard of No. 231 Johnston Street.</data>
      <data key="d1">event</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
