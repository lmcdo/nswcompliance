    <node id="be09acd907703659ea7019de95cd019d64d72e48d91a34f44137c974fb6dc5bb">
      <data key="d0">The enjoyment of sunlight, privacy and views is included in amenity.</data>
      <data key="d1">event</data>
      <data key="d2">53c13b983665ff26d3da688f01dce36924ff8f47738cc075f3d25157128dfe1a</data>
