    <node id="16b4be9fdf16f927733741b444f403f62079df747b349300c5400fa6b0506b66">
      <data key="d0">For pond-based aquaculture that is also intensive aquaculture—ponds must be capable of being drained or pumped and then completely dried.</data>
      <data key="d1">event</data>
      <data key="d2">0ec6db5829823b0613600a065b28614e88b6983d38545b52c563c8e70be7c760</data>
