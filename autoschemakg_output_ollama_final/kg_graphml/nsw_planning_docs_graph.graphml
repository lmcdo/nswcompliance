    <node id="a2bebede8e57077abe3476dcc8b6f3bd8ea52819df254f4fdbdbe5af98e7e648">
      <data key="d0">Conservation may include the process of maintenance, preservation, restoration, reconstruction, adaptation and interpretation.</data>
      <data key="d1">event</data>
      <data key="d2">53c13b983665ff26d3da688f01dce36924ff8f47738cc075f3d25157128dfe1a</data>
    </node>
