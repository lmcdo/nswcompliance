    <node id="1f4fb639404c93cb809ec950fb40a6a785901e73eccfe5417c60613c03612284">
      <data key="d0">the precinct houses three (3) of the Local Government Area’s (LGA) most significant live music venues</data>
      <data key="d1">event</data>
      <data key="d2">7594e5ca858e72058a27792feb5a22ac7948660c20ee7e2feaa3977e9e30d8f2</data>
    </node>
    <node id="ac357a7f897e1469a2d54f051374c1528fb84c55ad04ec96b24047658ef181e4">
      <data key="d0">traffic conflicts occur between large vehicles accessing industrial sites on streets also catering for through traffic</data>
      <data key="d1">event</data>
