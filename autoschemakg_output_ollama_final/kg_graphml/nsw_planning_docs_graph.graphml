      <data key="d2">327d5c5a4518394d99ba13202a679b7a367cb03a1a19a9220df4de5701488785</data>
    </node>
    <node id="22ed257fbb36a09cea0c4130bdfd98be3fbc5fcca295fed8611ed4d859ddd7fc">
      <data key="d0">Applicants must demonstrate that the following issues have been considered in the preparation of the subdivision or amalgamation application.</data>
      <data key="d1">event</data>
      <data key="d2">327d5c5a4518394d99ba13202a679b7a367cb03a1a19a9220df4de5701488785</data>
