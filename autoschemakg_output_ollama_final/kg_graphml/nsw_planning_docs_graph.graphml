    </node>
    <node id="dba578fb8bd8e6c8719cdbee88eaddc1bbb5cd94ac3ecbb5901389edc85645da">
      <data key="d0">Corner properties must have splayed corners for road widening purposes and to improve sight lines at intersections for vehicles, pedestrians and cyclists.</data>
      <data key="d1">event</data>
