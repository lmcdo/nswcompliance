      <data key="d1">entity</data>
      <data key="d2">9590c98e3065b3beb08b2ffd66b0556b9324b2aa3bc03edb432e648eebeff613</data>
    </node>
    <node id="a01102605dd7736ea3ee01aa4116d61fb1974432cd4c3461ed15de1aa5e7687c">
      <data key="d0">The public exhibition period for Marrickville DCP 2011 ended on 25 January 2009 and the draft was available online during this time.</data>
      <data key="d1">event</data>
      <data key="d2">9590c98e3065b3beb08b2ffd66b0556b9324b2aa3bc03edb432e648eebeff613</data>
    </node>
