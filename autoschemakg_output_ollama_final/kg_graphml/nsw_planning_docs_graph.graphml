    <node id="9d478fee79e8563a8606c27aa908f081409b76e99ef5622004eb6e372fb97774">
      <data key="d0">A site plan of a development demonstrating the feasibility of the proposed drainage systems within the site and connection to Council's system is created.</data>
      <data key="d1">event</data>
      <data key="d2">865000f3afc7e23add4b9571f70ca5970a6e0e67b83bae04fd3bf9471c3d9b53</data>
