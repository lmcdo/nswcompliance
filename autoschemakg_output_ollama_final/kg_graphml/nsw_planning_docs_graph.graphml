      <data key="d0">Photovoltaic panels should be removed from the roof when obsolete and sent to a recycling facility where possible.</data>
      <data key="d1">event</data>
      <data key="d2">0bcc451752c27efb3203091b5a395b7265e5e651c4cb05543a236a40d2288c94</data>
