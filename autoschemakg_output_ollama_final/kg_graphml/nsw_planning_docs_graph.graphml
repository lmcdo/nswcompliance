      <data key="d0">Heritage planning aims to ensure that the significant buildings, sites and elements of the past are appropriately managed and respected when planning for new development.</data>
      <data key="d1">event</data>
      <data key="d2">ab59c71153b36b3a31c41a8630d8a48a9746b14902e53abffbe110c0456c09c6</data>
    </node>
