      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
    <node id="9917becf21e0ddffa5f4ddab613d9c6776f56ff5d0a86c5fda54a5aea4d86dbc">
      <data key="d0">Properties on 170 View Street</data>
      <data key="d1">entity</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
    <node id="af91c4a2589ee6887171ab09338a2450ea114abc028c9688c3af5e1f47ebc4e7">
      <data key="d0">Development along the Johnston Street frontage is to have a maximum wall height of 4m and maximum building height of $7.5 m$ (i.e. two storeys) above Johnston Street, except for the portion of the site adjoining the southern boundary where development is to have a maximum wall height of 4m (i.e. one storey plus attic) above Johnston Street.</data>
      <data key="d1">event</data>
      <data key="d2">31cd6a0dd0c9c423d376cc0bb414d3159305c7e34a3c7b7051c6ffc7659e364f</data>
    </node>
