      <data key="d0">An application is made under the Environmental Planning and Assessment Act 1979 for consent or permission to carry out development.</data>
      <data key="d1">event</data>
      <data key="d2">865000f3afc7e23add4b9571f70ca5970a6e0e67b83bae04fd3bf9471c3d9b53</data>
