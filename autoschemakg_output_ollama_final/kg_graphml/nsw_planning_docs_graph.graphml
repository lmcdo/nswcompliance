    <node id="5652b85a9566d3821c3c487ed961bb7b3b021563374ae01e6a16d6f3c74fe892">
      <data key="d0">The precinct contains the Petersham South (Norwood Estate) and the Morgan Street Heritage Conservation Areas.</data>
      <data key="d1">event</data>
