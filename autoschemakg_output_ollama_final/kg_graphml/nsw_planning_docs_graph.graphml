    <node id="4384ec834d55f10aeef994a25e37155904e1ef61b75bb613db0c23d14a645424">
      <data key="d0">predict development or land use change</data>
      <data key="d1">entity</data>
      <data key="d2">25f525e73c6fd192ab7b50244d580c8adf873382d6cd2591aa5ecb8c8f95ddb4</data>
