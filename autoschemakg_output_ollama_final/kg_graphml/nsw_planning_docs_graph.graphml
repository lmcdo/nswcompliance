    <node id="7fe8105d14fd7a844a64e40ad355600849e832eec486ca137dd9d877201a8569">
      <data key="d0">Residential and community life free from nuisance arising from noise, vibration, smell, fumes, smoke, vapour, steam, soot, ash, dust, waste water, waste products or grit is included in amenity.</data>
      <data key="d1">event</data>
      <data key="d2">53c13b983665ff26d3da688f01dce36924ff8f47738cc075f3d25157128dfe1a</data>
