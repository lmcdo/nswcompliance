      <data key="d1">event</data>
      <data key="d2">0bcc451752c27efb3203091b5a395b7265e5e651c4cb05543a236a40d2288c94</data>
    </node>
    <node id="36570ed41c0c26ce5bb3a620a1fefb14509e0fbb15bd279806fe874798a84538">
      <data key="d0">The installation of a photovoltaic system may be granted development consent when it can be shown that the installation will not result in negative impacts on amenity.</data>
      <data key="d1">event</data>
      <data key="d2">0bcc451752c27efb3203091b5a395b7265e5e651c4cb05543a236a40d2288c94</data>
    </node>
