      <data key="d2">7594e5ca858e72058a27792feb5a22ac7948660c20ee7e2feaa3977e9e30d8f2</data>
    </node>
    <node id="2a5517192e4c3f78fde8d868cd576504106bb88faf052d9b1f3eaa75eafda119">
      <data key="d0">Some buildings in the precinct have been rendered and painted</data>
