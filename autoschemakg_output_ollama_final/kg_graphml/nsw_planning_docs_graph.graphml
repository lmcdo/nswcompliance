    <node id="2cb88bc15e0aeb27eae8f82d57a38fa16940352a5b069a5155e1e00942aa5faf">
      <data key="d0">Cultural significance</data>
      <data key="d1">entity</data>
      <data key="d2">53c13b983665ff26d3da688f01dce36924ff8f47738cc075f3d25157128dfe1a</data>
    </node>
