    <node id="921a95e8b614f668981d9eee4d24a3ffdb6821162246bb8036f73f4fd7d20564">
      <data key="d0">sunlight</data>
      <data key="d1">entity</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="5a2551345cd1f0e66d7d1c5a2bd90ff5d76c69a75d5651da2db010fe0f7807a3">
      <data key="d0">PV panels</data>
      <data key="d1">entity</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="e426cc7a545b74abc8868d0b2e3409915473cf6358d409d9a2571ffdb5f26221">
      <data key="d0">solar hot water systems</data>
      <data key="d1">entity</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="efa0cfe49c39690ea56078a8b2eefd3e09d67be0ff15812e7acb1988293a7061">
      <data key="d0">Direct solar access to windows must not be reduced to less than two hours between 9.00am and 3.00pm on 21 June.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="63fdbcf8dc10056dfd4d5239c766e1eba92cc9aef3f0135927369a148e87128f">
      <data key="d0">Where less than two hours of sunlight is currently available on 21 June, solar access should not be further reduced.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="7873e7135b16a2d8f45f1fb975b69b1ffb69e5e369fa14557d42c0c4b600cd38">
      <data key="d0">PV panels and solar hot water systems must receive a minimum four hours of direct sunlight between 9.00am and 3.00pm during midwinter.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="8b358faff6ddf70d5804f15ab2891c82865e3a8ee4959810fdd62bc85fb40bf2">
      <data key="d0">PV panels and solar hot water systems must be placed on areas of a building where there is minimal or no adverse impacts on the streetscape or architectural integrity of the host building and where there is minimal or no overshadowing.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="c328834fc0556c770761aacc39de938abfd7192e260ab6353fe95b334e1bf13d">
      <data key="d0">Direct solar access to windows of principal living areas must not be reduced to less than two hours between 9.00am and 3.00pm on 21 June.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="3ead3023ca910fcd5f25cf9cb42b386e56394881c40912e46ee849d7193a9dbb">
      <data key="d0">residential accommodation</data>
      <data key="d1">entity</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="8fe468533bce0904ff16306a91f8ef71f752e7cdb8cd9e4f25dd735243726569">
      <data key="d0">principal living areas</data>
      <data key="d1">entity</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="8f0d7ad907253bc7c95851d3731e33aa9862af75132d94318dc19cb7ce4393b7">
      <data key="d0">Solar access should not be further reduced if less than two hours of sunlight is currently available on 21 June.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
    <node id="cf277b47ae719213164598ae4f76ed1c4f8eb7fd5e29aa1cae0075ea3f1b81e5">
      <data key="d0">PV panels and solar hot water systems must be placed where there is minimal or no adverse impacts on the streetscape or architectural integrity of the host building.</data>
      <data key="d1">event</data>
      <data key="d2">f877657ae707f4029dc705d372402c01ce3377e9f031f340c4f24e9aab95865b</data>
    </node>
