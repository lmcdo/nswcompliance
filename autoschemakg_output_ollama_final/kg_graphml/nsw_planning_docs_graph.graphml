      <data key="d0">item or area</data>
      <data key="d1">entity</data>
      <data key="d2">ab59c71153b36b3a31c41a8630d8a48a9746b14902e53abffbe110c0456c09c6</data>
    </node>
    <node id="dcb9e9fab31e6a89f8ad1d2f01870b93ccbb5e46c94917eda704be3baf18c4d9">
      <data key="d0">The intention of these provisions is to ensure that decisions about change are made with due regard to heritage significance, and that opportunities to improve the understanding and appreciation of this significance are taken.</data>
      <data key="d1">event</data>
      <data key="d2">ab59c71153b36b3a31c41a8630d8a48a9746b14902e53abffbe110c0456c09c6</data>
    </node>
